<UserControl x:Class="OptikFormApp.Views.QuestionDifficultyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="950">

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Kurumsal Başlık -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource HoverBg}" Margin="0,0,11,0">
                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource FluentIconFont}" FontSize="15" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Soru Zorluk Düzeyi Analizi" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    <TextBlock Text="{Binding DifficultyDistribution}" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 2. Kurumsal Özet Kartları (5 Kart) -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,0,0,14">
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,3,1,1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="KOLAY (≥ %80)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuestionDifficulties, Converter={StaticResource DifficultyCountConverter}, ConverterParameter='Kolay'}"
                               FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Success}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,3,1,1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Warning}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ORTA (%60–79)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuestionDifficulties, Converter={StaticResource DifficultyCountConverter}, ConverterParameter='Orta'}"
                               FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Warning}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,3,1,1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Error}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ZOR (%40–59)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuestionDifficulties, Converter={StaticResource DifficultyCountConverter}, ConverterParameter='Zor'}"
                               FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Error}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,3,1,1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ÇOK ZOR (&lt; %40)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuestionDifficulties, Converter={StaticResource DifficultyCountConverter}, ConverterParameter='Çok Zor'}"
                               FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource TextMain}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOPLAM SORU" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{Binding QuestionDifficulties.Count}"
                               FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. Soru Bazında Detaylı Zorluk Listesi -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding QuestionDifficulties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}" CornerRadius="9" Padding="12,10" Margin="0,0,0,7" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{Binding DifficultyColor}" CornerRadius="7" Padding="6,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QuestionNumber, StringFormat='S{0}'}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DifficultyLevel}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        <Border Background="{DynamicResource HeaderBg}" CornerRadius="3" Height="6" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                                            <Border Background="{Binding DifficultyColor}" CornerRadius="3" Height="6" HorizontalAlignment="Left"
                                                    Width="{Binding SuccessRate, Converter={StaticResource ValueToWidthConverter}, ConverterParameter=240}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SuccessRate, StringFormat='{}%{0:F1}'}" FontSize="14" FontWeight="ExtraBold" Foreground="{Binding DifficultyColor}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Başarı" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CorrectAnswers}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Success}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Doğru" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalAnswers}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Yanıt" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
