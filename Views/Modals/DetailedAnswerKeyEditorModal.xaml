<UserControl x:Class="OptikFormApp.Views.Modals.DetailedAnswerKeyEditorModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="780">
    
    <Grid Visibility="{Binding IsDetailedAnswerKeyEditorOpen, Converter={StaticResource BoolToVis}}" 
          Background="{DynamicResource ModalBackdrop}">
        
        <!-- Spacious Modern Modal Container -->
        <Border Width="780" 
                MaxHeight="620"
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                CornerRadius="20"
                Padding="0"
                Margin="20"
                Background="{DynamicResource CardBg}">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.25" BlurRadius="50" ShadowDepth="15"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header with Gradient -->
                <Border Grid.Row="0" 
                        Height="76"
                        CornerRadius="20,20,0,0" 
                        Padding="24,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource AccentPurpleColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentVioletColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="12" Background="#25FFFFFF" Margin="0,0,14,0">
                                <TextBlock Text="🔑" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Detaylı Cevap Anahtarı Editörü" 
                                               FontSize="17" 
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                    <Border Background="#30FFFFFF" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding SelectedAnswerKeyForEdit.BookletName, StringFormat='Kitapçık {0}'}" 
                                                   FontSize="11" 
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Her sorunun doğru şıkkını tek tek veya toplu olarak düzenleyin" 
                                           FontSize="11" 
                                           Foreground="White"
                                           Opacity="0.85"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Close Button -->
                        <Button Grid.Column="1"
                                Command="{Binding CloseDetailedAnswerKeyEditorCommand}"
                                VerticalAlignment="Center"
                                Width="32" 
                                Height="32" 
                                Background="#25FFFFFF"
                                Foreground="White"
                                FontSize="13"
                                Cursor="Hand">
                            <Button.Content>✕</Button.Content>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Action Toolbar -->
                <Border Grid.Row="1" 
                        Padding="18,12"
                        Background="{DynamicResource HeaderBg}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Add Question -->
                            <Button Command="{Binding AddQuestionToAnswerKeyCommand}"
                                    Padding="12,7"
                                    Background="{DynamicResource Success}"
                                    Foreground="White"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"
                                    ToolTip="Sonuna yeni bir soru ekle">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="Soru Ekle"/>
                                </StackPanel>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <!-- Remove Last Question -->
                            <Button Command="{Binding RemoveLastQuestionFromAnswerKeyCommand}"
                                    Padding="12,7"
                                    Background="{DynamicResource ErrorBgLight}"
                                    Foreground="{DynamicResource Error}"
                                    BorderBrush="{DynamicResource Error}"
                                    BorderThickness="1"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Margin="0,0,12,0"
                                    Cursor="Hand"
                                    ToolTip="En sondaki soruyu sil">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="Son Soruyu Sil"/>
                                </StackPanel>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            
                            <!-- Bulk Entry -->
                            <Button Command="{Binding OpenBulkAnswerEntryCommand}"
                                    Padding="12,7"
                                    Background="{DynamicResource AccentBgLight}"
                                    Foreground="{DynamicResource Accent}"
                                    BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="1"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"
                                    ToolTip="Tüm cevapları tek seferde metin olarak yapıştırın">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="Toplu Metin Girişi"/>
                                </StackPanel>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <!-- Analyze -->
                            <Button Command="{Binding AnalyzeAnswerKeyCommand}"
                                    Padding="12,7"
                                    Background="{DynamicResource WarningBgLight}"
                                    Foreground="{DynamicResource Warning}"
                                    BorderBrush="{DynamicResource Warning}"
                                    BorderThickness="1"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    ToolTip="Şık dağılımı (A, B, C, D, E) dengesini analiz et">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="Şık Dağılım Analizi"/>
                                </StackPanel>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Right Stats Pill -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Toplam Soru: " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedAnswerKeyForEdit.AnswerDetails.Count}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPurple}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Question Cards Grid -->
                <ScrollViewer Grid.Row="2" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,16">
                    <ItemsControl ItemsSource="{Binding SelectedAnswerKeyForEdit.AnswerDetails}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" 
                                        Padding="6,6"
                                        Margin="4"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Border}"
                                        Background="{DynamicResource HeaderBg}"
                                        Width="84"
                                        Height="78">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Question Label -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="Soru " FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding QuestionNumber}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        </StackPanel>
                                        
                                        <!-- Answer Input Box -->
                                        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5" CornerRadius="8">
                                            <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="20"
                                                     FontWeight="ExtraBold"
                                                     Foreground="{DynamicResource AccentPurple}"
                                                     CaretBrush="{DynamicResource AccentPurple}"
                                                     MaxLength="1"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Padding="0"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     CharacterCasing="Upper"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 4. Footer -->
                <Border Grid.Row="3" 
                        CornerRadius="0,0,20,20" 
                        Padding="24,14"
                        Background="{DynamicResource HeaderBg}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="İpucu: Kutulara tıklayıp doğrudan A, B, C, D, E yazabilirsiniz. Kaydettiğinizde puanlar anında güncellenir." 
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Save & Close Button -->
                        <Button Content="💾 Değişiklikleri Kaydet &amp; Puanla" 
                                Command="{Binding CloseDetailedAnswerKeyEditorCommand}"
                                Background="{DynamicResource AccentPurple}" 
                                Foreground="White"
                                Padding="20,9" 
                                FontSize="12" 
                                FontWeight="Bold"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentViolet}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>