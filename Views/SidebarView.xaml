<UserControl x:Class="OptikFormApp.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="280">
    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <Grid Margin="14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.4*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Courses Header -->
            <Grid Grid.Row="0" Margin="4,0,4,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Derslerim" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                </StackPanel>
                <Button Command="{Binding ShowAddCourseCommand}" HorizontalAlignment="Right" 
                        Width="26" Height="26" Padding="0" Background="{DynamicResource Accent}" Foreground="White"
                        Cursor="Hand" ToolTip="Yeni Ders Ekle">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                                <TextBlock Text="+" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Course List -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" 
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="4,0,0,0">
                                <Border Background="{DynamicResource HoverBg}" CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Code}" FontSize="10" FontWeight="ExtraBold" Foreground="{DynamicResource AccentHover}"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="✎" Command="{Binding DataContext.OpenRenameCourseCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" FontSize="12" Padding="5,2" Cursor="Hand" ToolTip="Dersi Düzenle"/>
                                <Button Content="✕" Command="{Binding DataContext.DeleteCourseCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Error}" FontSize="12" Padding="5,2" Cursor="Hand" ToolTip="Bu dersi sil"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Margin="0,1" Padding="8,8">
                                        <Grid>
                                            <Border x:Name="Indicator" Width="3" HorizontalAlignment="Left" CornerRadius="1.5" Background="Transparent" Margin="-8,-4,0,-4"/>
                                            <ContentPresenter Margin="4,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border}"/>
                                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Separator & Exam History Header -->
            <StackPanel Grid.Row="2" Margin="4,12,4,8">
                <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Success}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Sınav Geçmişi" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedCourse.Name}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="16,2,0,0"/>
            </StackPanel>

            <!-- Exam List -->
            <ListBox Grid.Row="3" ItemsSource="{Binding CourseExams}" SelectedItem="{Binding SelectedExam}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="4,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DisplayDate}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="✎" Command="{Binding DataContext.OpenRenameExamCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" FontSize="11" Padding="4,2" Cursor="Hand" ToolTip="Sınavı Düzenle"/>
                                <Button Content="✕" Command="{Binding DataContext.DeleteExamCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Error}" FontSize="11" Padding="4,2" Cursor="Hand" ToolTip="Bu sınavı sil"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Margin="0,1" Padding="8,7">
                                        <Grid>
                                            <Border x:Name="Indicator" Width="3" HorizontalAlignment="Left" CornerRadius="1.5" Background="Transparent" Margin="-8,-4,0,-4"/>
                                            <ContentPresenter Margin="4,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border}"/>
                                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Success}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>