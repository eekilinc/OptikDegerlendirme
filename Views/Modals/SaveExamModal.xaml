<UserControl x:Class="OptikFormApp.Views.Modals.SaveExamModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="440" d:DesignWidth="480">
    <Grid Visibility="{Binding IsSaveExamModalOpen, Converter={StaticResource BoolToVis}}" 
          Background="{DynamicResource ModalBackdrop}">
        <Border Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="14"
                MaxWidth="480"
                MaxHeight="560"
                Margin="20,16"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource FluentIconFont}" FontSize="15.5" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Sınavı Veritabanına Kaydet" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="Değerlendirilen sınav sonuçlarını ilgili dersin arşivine ekleyin" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseSaveExamModalCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- İçerik -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16">
                        <TextBlock Text="Sınav Adı (Örn: 2026 Güz Vize Sınavı)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NewExamName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" Padding="10,8" FontSize="13"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bağlı Olduğu Ders" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourseForSave}" Padding="10,8" FontSize="12.5">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Code}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock Text="—" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding ToggleAddCourseInlineCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                    Style="{StaticResource OutlineButton}" Padding="11,8" FontSize="11.5" ToolTip="Hızlı yeni ders ekle">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource FluentIconFont}" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yeni Ders" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding DeleteSelectedCourseInlineCommand}" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                    Style="{StaticResource OutlineButton}" BorderBrush="{DynamicResource Error}" Foreground="{DynamicResource Error}" Padding="10,8" FontSize="11.5"
                                    IsEnabled="{Binding SelectedCourseForSave, Converter={StaticResource NullToBool}}" ToolTip="Seçili dersi sil">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FluentIconFont}" FontSize="11"/>
                            </Button>
                        </Grid>

                        <!-- Satır İçi Hızlı Ders Ekleme -->
                        <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14"
                                Visibility="{Binding IsAddCourseInlineOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Hızlı Ders Tanımla" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ders Kodu" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewCourseCodeInline, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12.5" MaxLength="12" CharacterCasing="Upper"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ders Adı" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewCourseNameInline, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12.5"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Vazgeç" Command="{Binding ToggleAddCourseInlineCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" FontSize="11.5" Margin="0,0,6,0"/>
                                    <Button Content="Dersi Ekle" Command="{Binding AddCourseInlineCommand}" Background="{DynamicResource Success}" Foreground="White" Padding="14,5" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Öğrenci Sayısı Özeti -->
                        <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource FluentIconFont}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Kaydedilecek Öğrenci Sayısı:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Students.Count, FallbackValue=0}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Alt Çubuk -->
                <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid>
                        <Button Content="Vazgeç (Esc)" Command="{Binding CloseSaveExamModalCommand}" HorizontalAlignment="Left" Style="{StaticResource OutlineButton}" Padding="16,7" FontSize="12"/>
                        <Button Content="Sınavı Kaydet" IsDefault="True" Command="{Binding ConfirmSaveExamCommand}" IsEnabled="{Binding Students.Count}"
                                HorizontalAlignment="Right" Background="{DynamicResource Accent}" Foreground="White" Padding="22,7" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
