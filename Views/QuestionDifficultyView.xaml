<UserControl x:Class="OptikFormApp.Views.QuestionDifficultyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OptikFormApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="950">

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Kurumsal Başlık -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource HoverBg}" Margin="0,0,10,0">
                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource FluentIconFont}" FontSize="14.5" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Soru Zorluk Düzeyi Analizi" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding DifficultyDistribution}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- 2. Responsive Kurumsal Özet Kartları (5 -> 3 -> 2 sütun adaptif) -->
        <local:ResponsiveUniformGrid Grid.Row="1" MaxColumns="5" MinColumns="2" MinColumnWidth="150" Margin="-4,0,-4,8">
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,3,1,1" CornerRadius="10" Padding="12,9" Margin="4,0,4,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="KOLAY (≥ %80)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuestionDifficulties, Converter={StaticResource DifficultyCountConverter}, ConverterParameter='Kolay'}"
                               FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Success}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,3,1,1" CornerRadius="10" Padding="12,9" Margin="4,0,4,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Warning}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ORTA (%60–79)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuestionDifficulties, Converter={StaticResource DifficultyCountConverter}, ConverterParameter='Orta'}"
                               FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Warning}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,3,1,1" CornerRadius="10" Padding="12,9" Margin="4,0,4,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Error}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ZOR (%40–59)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuestionDifficulties, Converter={StaticResource DifficultyCountConverter}, ConverterParameter='Zor'}"
                               FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Error}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,3,1,1" CornerRadius="10" Padding="12,9" Margin="4,0,4,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ÇOK ZOR (&lt; %40)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuestionDifficulties, Converter={StaticResource DifficultyCountConverter}, ConverterParameter='Çok Zor'}"
                               FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource TextMain}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="4,0,4,6">
                <StackPanel>
                    <TextBlock Text="TOPLAM SORU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding QuestionDifficulties.Count}"
                               FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </local:ResponsiveUniformGrid>

        <!-- 3. Soru Bazında Detaylı Zorluk Listesi (%100 Esnek ActualWidth İlerleme Çubuklu) -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="12,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding QuestionDifficulties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}" CornerRadius="9" Padding="12,9" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="68"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{Binding DifficultyColor}" CornerRadius="7" Padding="5,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QuestionNumber, StringFormat='S{0}'}" FontSize="12.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DifficultyLevel}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        <Grid Height="6" Background="{DynamicResource HeaderBg}" Margin="0,6,0,0">
                                            <Border Background="{Binding DifficultyColor}" CornerRadius="3" Height="6" HorizontalAlignment="Left">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource MultiValuePercentageConverter}">
                                                        <Binding Path="SuccessRate"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SuccessRate, StringFormat='{}%{0:F1}'}" FontSize="13" FontWeight="ExtraBold" Foreground="{Binding DifficultyColor}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Başarı" FontSize="9.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CorrectAnswers}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Success}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Doğru" FontSize="9.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalAnswers}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Yanıt" FontSize="9.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
