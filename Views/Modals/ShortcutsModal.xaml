<UserControl x:Class="OptikFormApp.Views.Modals.ShortcutsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OptikFormApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="540" d:DesignWidth="600">

    <Grid Visibility="{Binding IsShortcutsOpen, Converter={StaticResource BoolToVis}}" 
          Background="{DynamicResource ModalBackdrop}">

        <Border MaxWidth="600"
                MaxHeight="580"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Margin="20,16"
                CornerRadius="14"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource FluentIconFont}" FontSize="15.5" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Klavye Kısayolları Rehberi" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="Sınav değerlendirme ve raporlama süreçlerini hızlandıran kısayollar" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseShortcutsCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- İçerik -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <views:ResponsiveUniformGrid MaxColumns="2" MinColumns="1" MinColumnWidth="240" Margin="16,14">

                        <!-- Sol Sütun: Dosya & Rapor -->
                        <StackPanel Margin="4">
                            <TextBlock Text="DOSYA VE RAPORLAMA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="2,0,0,8"/>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                <Grid>
                                    <TextBlock Text="Optik Veri Yükle" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="Ctrl + O" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                <Grid>
                                    <TextBlock Text="Sınavı Kaydet" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="Ctrl + S" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                <Grid>
                                    <TextBlock Text="Excel Raporu Al" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="Ctrl + E" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                <Grid>
                                    <TextBlock Text="Akademik Tam Rapor PDF" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="Ctrl+Shift+R" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9">
                                <Grid>
                                    <TextBlock Text="Toplu PDF Karne" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="Ctrl + P" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Sağ Sütun: Değerlendirme & Düzen -->
                        <StackPanel Margin="4">
                            <TextBlock Text="DEĞERLENDİRME VE DÜZEN" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="2,0,0,8"/>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                <Grid>
                                    <TextBlock Text="Puanları Hesapla" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="F5" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                <Grid>
                                    <TextBlock Text="CSV Olarak Dışa Aktar" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="Ctrl+Shift+C" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                <Grid>
                                    <TextBlock Text="Geri Al (Undo)" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="Ctrl + Z" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                <Grid>
                                    <TextBlock Text="Yinele (Redo)" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="Ctrl + Y" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9">
                                <Grid>
                                    <TextBlock Text="Kısayol Rehberini Aç" FontSize="12" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="F1" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </views:ResponsiveUniformGrid>
                </ScrollViewer>

                <!-- Alt Çubuk -->
                <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid>
                        <TextBlock Text="Açılır pencerelerde Enter onaylar, Esc kapatır." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        <Button Content="Kapat" Command="{Binding CloseShortcutsCommand}" IsDefault="True"
                                HorizontalAlignment="Right" Background="{DynamicResource Accent}" Foreground="White" Padding="22,7" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
