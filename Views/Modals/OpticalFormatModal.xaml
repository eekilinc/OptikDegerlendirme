<UserControl x:Class="OptikFormApp.Views.Modals.OpticalFormatModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="700">

    <Grid Visibility="{Binding IsOpticalFormatOpen, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource ModalBackdrop}">
        <Border MaxWidth="680" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                CornerRadius="20" Background="{DynamicResource CardBg}" Margin="20,16">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.25" BlurRadius="50" ShadowDepth="15"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Height="74" CornerRadius="20,20,0,0" Padding="24,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentVioletColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="10" Background="#25FFFFFF" Margin="0,0,12,0">
                                <TextBlock Text="📐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dinamik Optik Form Format Ayarlayıcı" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Farklı optik okuyucu şablonları için karakter başlangıç ve uzunluk konumlarını özelleştirin" FontSize="11" Foreground="White" Opacity="0.85"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding CloseOpticalFormatCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="30" Height="30" Background="#25FFFFFF" Foreground="White" FontSize="13" Cursor="Hand" Content="✕">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- İçerik -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,16">
                    <StackPanel>
                        <!-- Örnek Satır Girişi -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Örnek Optik Satır (Canlı Test)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                            <Button Command="{Binding LoadSampleOpticalLineCommand}" Style="{StaticResource OutlineButton}"
                                    HorizontalAlignment="Right" Padding="10,4" FontSize="11" Content="📂 Dosyadan Örnek Satır Al"/>
                        </Grid>
                        <TextBox Text="{Binding SampleOpticalLine, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12" Padding="10,8" Margin="0,0,0,16"/>

                        <!-- Sütun Konumları -->
                        <TextBlock Text="Alan Karakter Konumları (0 tabanlı indeks)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,6,8">
                                <StackPanel>
                                    <TextBlock Text="Ad Soyad Başlangıç" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalNameStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="3,0,3,8">
                                <StackPanel>
                                    <TextBlock Text="Ad Soyad Uzunluk" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalNameLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Kitapçık İndeksi" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalBookletStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Öğrenci No Başlangıç" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalIdStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="Öğrenci No Uzunluk" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalIdLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Cevaplar Başlangıç" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalAnswersStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Canlı Ayrıştırma Önizlemesi -->
                        <Border Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="✨ Canlı Ayrıştırma Önizlemesi" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Ad Soyad:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding PreviewFullName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Öğrenci No:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding PreviewStudentId}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Kitapçık:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding PreviewBooklet}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Cevaplar:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding PreviewAnswers}" FontSize="12" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,20,20" Padding="20,12">
                    <Grid>
                        <Button Command="{Binding ResetOpticalFormatCommand}" Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Left" Padding="14,7" FontSize="12" Content="↺ Varsayılan (Ağlasun MYO)"/>
                        <Button Command="{Binding CloseOpticalFormatCommand}" HorizontalAlignment="Right"
                                Background="{DynamicResource AccentPurple}" Foreground="White" Padding="24,7" FontSize="12" FontWeight="Bold" Content="Kaydet ve Kapat"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
