<UserControl x:Class="OptikFormApp.Views.Modals.OpticalFormatModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OptikFormApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="680">

    <Grid Visibility="{Binding IsOpticalFormatOpen, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource ModalBackdrop}">
        <Border MaxWidth="680" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                CornerRadius="14" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="20,16" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource FluentIconFont}" FontSize="15.5" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Dinamik Optik Form Format Ayarlayıcı" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="Farklı optik okuyucu şablonları için karakter başlangıç ve uzunluk konumlarını tanımlayın" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseOpticalFormatCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- İçerik -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Örnek Optik Satır (Canlı Ayrıştırma Testi)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                            <Button Command="{Binding LoadSampleOpticalLineCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" Padding="10,5" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource FluentIconFont}" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dosyadan Örnek Satır Al" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBox Text="{Binding SampleOpticalLine, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Cascadia Mono" FontSize="12" Padding="10,8" Margin="0,0,0,14"/>

                        <TextBlock Text="Alan Karakter Konumları (0 tabanlı indeks)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,8"/>
                        <views:ResponsiveUniformGrid MaxColumns="3" MinColumns="2" MinColumnWidth="165" Margin="-4,0,-4,10">
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Ad Soyad Başlangıç" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalNameStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Ad Soyad Uzunluk" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalNameLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Kitapçık İndeksi" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalBookletStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Öğrenci No Başlangıç" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalIdStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Öğrenci No Uzunluk" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalIdLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Cevaplar Başlangıç" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding OpticalAnswersStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontWeight="Bold" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                        </views:ResponsiveUniformGrid>

                        <!-- Canlı Ayrıştırma Önizlemesi -->
                        <Border Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Canlı Ayrıştırma Önizlemesi" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                                <views:ResponsiveUniformGrid MaxColumns="2" MinColumns="1" MinColumnWidth="220">
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="Ad Soyad" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding PreviewFullName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Öğrenci No" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding PreviewStudentId}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Kitapçık" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding PreviewBooklet}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Cevap Dizisi" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding PreviewAnswers}" FontSize="11.5" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource Success}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </views:ResponsiveUniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Alt Çubuk -->
                <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid>
                        <Button Command="{Binding ResetOpticalFormatCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Padding="14,7" FontSize="12" Content="Varsayılana Sıfırla (Ağlasun MYO)"/>
                        <Button Command="{Binding CloseOpticalFormatCommand}" IsDefault="True" HorizontalAlignment="Right"
                                Background="{DynamicResource Accent}" Foreground="White" Padding="22,7" FontSize="12" FontWeight="SemiBold" Content="Kaydet ve Kapat"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
