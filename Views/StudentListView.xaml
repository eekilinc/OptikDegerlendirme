<UserControl x:Class="OptikFormApp.Views.StudentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:OptikFormApp.ViewModels"
             xmlns:local="clr-namespace:OptikFormApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <vm:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>
    <Grid Margin="12,10,12,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Esnek Arama Çubuğu, Hızlı Filtreler ve Yoklama Eşleştirme -->
        <local:ResponsiveToolbarPanel Grid.Row="0" StretchFirst="True" MinFirstWidth="230" HorizontalSpacing="12" VerticalSpacing="8" Margin="0,2,0,10">
            <!-- Arama Çubuğu -->
            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,6.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource FluentIconFont}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                             FontSize="12" Padding="0" Foreground="{DynamicResource TextMain}">
                        <TextBox.Resources>
                            <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.55" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Öğrenci numarası veya ad soyad ile filtrele..." FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Hızlı Filtreler & Yoklama Eşleştirme (Dar Ekranda Temiz Sarmalanır) -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Tümü" Command="{Binding SetQuickFilterCommand}" CommandParameter="All"
                        Style="{StaticResource OutlineButton}" Padding="9,5.5" Margin="0,2,5,2" FontSize="11" FontWeight="SemiBold"/>
                <Button Command="{Binding SetQuickFilterCommand}" CommandParameter="Passed"
                        Style="{StaticResource OutlineButton}" Padding="9,5.5" Margin="0,2,5,2" FontSize="11" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Success}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Geçenler" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetQuickFilterCommand}" CommandParameter="Conditional"
                        Style="{StaticResource OutlineButton}" Padding="9,5.5" Margin="0,2,5,2" FontSize="11" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Warning}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Şartlı" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetQuickFilterCommand}" CommandParameter="Failed"
                        Style="{StaticResource OutlineButton}" Padding="9,5.5" Margin="0,2,8,2" FontSize="11" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Error}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Kalanlar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="16" Background="{DynamicResource Border}" Margin="0,2,8,2" VerticalAlignment="Center"/>

                <Button Command="{Binding OpenRosterMatchCommand}" Style="{StaticResource OutlineButton}" Padding="10,5.5" Margin="0,2,0,2" FontSize="11" FontWeight="SemiBold"
                        ToolTip="OBS sınıf listesiyle karşılaştır (Sınava girmeyenler ve numara hataları)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Yoklama Eşleştir" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </local:ResponsiveToolbarPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding StudentsView}" RowHeight="{Binding GridRowHeight}"
                  Visibility="{Binding Students.Count, Converter={StaticResource DataToVisConverter}}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.IsContainerVirtualizable="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  Background="{DynamicResource CardBg}"
                  Foreground="{DynamicResource TextMain}"
                  RowBackground="{DynamicResource CardBg}"
                  AlternatingRowBackground="{DynamicResource AltRowBg}"
                  BorderThickness="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Öğrenci Detayı ve Cevapları Düzenle"
                                          Command="{Binding Data.OpenStudentDetailCommand, Source={StaticResource Proxy}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Bireysel PDF Sınav Karnesi Oluştur (.pdf)"
                                          Command="{Binding Data.ExportSinglePdfCommand, Source={StaticResource Proxy}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Öğrenci No ve Puanı Kopyala"
                                          Command="{Binding Data.CopyStudentSummaryCommand, Source={StaticResource Proxy}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="{Binding DataContext.GridCellPadding, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" SortMemberPath="RowNumber" Width="Auto" MinWidth="36">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ÖĞRENCİ NO" Binding="{Binding StudentId}" SortMemberPath="StudentId" Width="Auto" MinWidth="92"/>
                <DataGridTextColumn Header="AD SOYAD" Binding="{Binding FullName}" SortMemberPath="FullName" Width="1.4*" MinWidth="145">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="KİTAPÇIK" Binding="{Binding BookletType}" SortMemberPath="BookletType" Width="Auto" MinWidth="68">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <DataGridTemplateColumn Header="ÖĞRENCİ CEVAPLARI" Width="1.2*" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding ColoredAnswers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Character}" Foreground="{Binding State, Converter={StaticResource AnswerStateConverter}}" FontFamily="Consolas" FontSize="13.5" FontWeight="Bold" Margin="0,0,1,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="D" Binding="{Binding CorrectCount}" SortMemberPath="CorrectCount" Width="42"/>
                <DataGridTextColumn Header="Y" Binding="{Binding IncorrectCount}" SortMemberPath="IncorrectCount" Width="42"/>
                <DataGridTextColumn Header="B" Binding="{Binding EmptyCount}" SortMemberPath="EmptyCount" Width="42"/>
                
                <DataGridTextColumn Header="NET" Binding="{Binding NetCount, StringFormat={}{0:N2}}" SortMemberPath="NetCount" Width="58">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="PUAN" Binding="{Binding Score, StringFormat={}{0:N2}}" SortMemberPath="Score" Width="62">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="SIRA" Binding="{Binding Rank}" SortMemberPath="Rank" Width="48">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- HARF NOTU ROZETİ (Tek sınavda varsayılan gizli, Ayarlardan açılabilir) -->
                <DataGridTemplateColumn Header="HARF" SortMemberPath="LetterGrade" Width="62"
                                        Visibility="{Binding Data.ShowLetterGradeColumn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="AA">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="BA">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="BB">
                                                <Setter Property="Background" Value="{DynamicResource AccentBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="CB">
                                                <Setter Property="Background" Value="{DynamicResource AccentBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="CC">
                                                <Setter Property="Background" Value="{DynamicResource WarningBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="DC">
                                                <Setter Property="Background" Value="{DynamicResource WarningBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="DD">
                                                <Setter Property="Background" Value="{DynamicResource WarningBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="FD">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="FF">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBgLight}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding LetterGrade}" FontWeight="Bold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="AA">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="BA">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="BB">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentViolet}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="CB">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentViolet}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="CC">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="DC">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="DD">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="FD">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="FF">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- DURUM ROZETİ -->
                <DataGridTemplateColumn Header="DURUM" SortMemberPath="Status" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Geçti">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Şartlı Geçti">
                                                <Setter Property="Background" Value="{DynamicResource WarningBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Kaldı">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBgLight}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Geçti">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Şartlı Geçti">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Kaldı">
                                                    <Setter Property="Foreground" Value="{DynamicResource Error}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- DETAY / İŞLEM -->
                <DataGridTemplateColumn Header="DETAY" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Öğrenci Detayı / Cevapları Düzenle"
                                    Command="{Binding DataContext.OpenStudentDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="6,4">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource FluentIconFont}" FontSize="12" Foreground="{DynamicResource Accent}"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- KURUMSAL BOŞ DURUM (EMPTY STATE) -->
        <Border Grid.Row="1" Visibility="{Binding Students.Count, Converter={StaticResource CountToVisConverter}}" 
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Padding="20">
            <StackPanel>
                <Border Width="64" Height="64" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="15" Margin="0,0,0,14" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource FluentIconFont}" FontSize="26" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Henüz Optik Sınav Verisi Yüklenmedi" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                <TextBlock Text="Değerlendirmeye başlamak için optik okuyucu dosyasını (.txt veya .dat) bu pencereye sürükleyip bırakın ya da aşağıdaki butonu kullanın."
                           FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,18" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                <Button Command="{Binding LoadTxtCommand}" Style="{StaticResource PipelineButton}" 
                        Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="White" Padding="20,9" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource FluentIconFont}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Optik Veri Dosyası Seç (Ctrl+O)" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
