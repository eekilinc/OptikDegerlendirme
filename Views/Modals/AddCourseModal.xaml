<UserControl x:Class="OptikFormApp.Views.Modals.AddCourseModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="340" d:DesignWidth="440">
    <Grid Visibility="{Binding IsAddCourseOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ModalBackdrop}">
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" MaxWidth="440" Margin="20,16" VerticalAlignment="Center" HorizontalAlignment="Stretch" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.25" BlurRadius="32" ShadowDepth="8"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Üst Kurumsal Vurgu Çizgisi -->
                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- Kurumsal Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="&#xE82D;" FontFamily="{StaticResource FluentIconFont}" FontSize="15" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Yeni Ders Tanımla" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                <TextBlock Text="Sınav arşivlerini gruplamak için ders kodu ve adını girin" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseAddCourseCommand}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Kapat (Esc)">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Form Alanları -->
                <StackPanel Grid.Row="2" Margin="20,18">
                    <TextBlock Text="Ders Kodu (Örn: BİL101)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewCourseCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" Padding="10,9" FontSize="13.5"/>

                    <TextBlock Text="Ders Adı (Örn: Algoritma ve Programlama)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewCourseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" Padding="10,9" FontSize="13.5"/>
                </StackPanel>

                <!-- Alt Aksiyonlar (Enter = Kaydet, Esc = Vazgeç) -->
                <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Vazgeç (Esc)" IsCancel="True" Command="{Binding CloseAddCourseCommand}" Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Dersi Kaydet" IsDefault="True" Command="{Binding AddCourseCommand}" Background="{DynamicResource Accent}" Padding="14,8" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
