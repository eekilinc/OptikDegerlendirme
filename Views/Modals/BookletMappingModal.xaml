<UserControl x:Class="OptikFormApp.Views.Modals.BookletMappingModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="700">
    <Grid Visibility="{Binding IsBookletMappingOpen, Converter={StaticResource BoolToVis}}" 
          Background="#CC000000">
        
        <Border Width="620" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                CornerRadius="24"
                Padding="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AppBg}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TextMain}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="60" ShadowDepth="20"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (Indigo Gradient) -->
                <Border Grid.Row="0" Height="90" CornerRadius="24,24,0,0" Padding="28,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#4F46E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ğŸ”„ KitapÃ§Ä±k EÅŸleme Matrisi" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Kaynak kitapÃ§Ä±ktan hedef kitapÃ§Ä±ÄŸÄ± otomatik tÃ¼retin" FontSize="12" Foreground="{DynamicResource AccentBgLight}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding CloseBookletMappingCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#20FFFFFF" BorderThickness="0" Foreground="White"
                                Width="34" Height="34" FontSize="16" Cursor="Hand">
                            <Button.Content>âœ•</Button.Content>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="17">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="24">
                    <!-- Config Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Source Booklet -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kaynak KitapÃ§Ä±k" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding AnswerKeys}" DisplayMemberPath="BookletName" 
                                      SelectedItem="{Binding SelectedSourceAnswerKey, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="10,8" MinHeight="38"/>
                        </StackPanel>

                        <!-- Target Booklet Name -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TÃ¼retilecek KitapÃ§Ä±k AdÄ±" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding TargetBookletName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8" MinHeight="38" FontWeight="Bold" FontSize="14" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Instruction Box -->
                    <Border Background="{DynamicResource AccentBgLight}" CornerRadius="10" Padding="12,10" Margin="0,0,0,14" BorderBrush="{DynamicResource AccentBgLight}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="â„¹ï¸ EÅŸleme FormatÄ± KÄ±lavuzu" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}" Margin="0,0,0,4"/>
                            <TextBlock Text="â€¢ Ok formatÄ±: 1->5, 2->1, 3->4 (Hedefin 1. sorusu KaynaÄŸÄ±n 5. sorusudur)&#x0a;â€¢ Liste formatÄ±: 5, 1, 4, 2, 3 (Hedefin sÄ±rasÄ±yla kaynak soru numaralarÄ±)&#x0a;â€¢ Excel'den 2 sÃ¼tun kopyalayabilirsiniz." 
                                       FontSize="11" Foreground="{DynamicResource AccentViolet}" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Input Area -->
                    <TextBlock Text="EÅŸleme Listesi / Matris Metni" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding MappingInputText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="13" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" Height="140" Padding="10"
                             Background="White" BorderBrush="{DynamicResource Border}" BorderThickness="1"/>

                    <!-- Live Preview / Validation Box -->
                    <Border CornerRadius="10" Padding="12,10" Margin="0,14,0,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F0FDF4"/>
                                <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMappingValid}" Value="False">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding MappingStatusHeader}" FontSize="12" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#15803D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMappingValid}" Value="False">
                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding MappingPreviewOrErrorMessage}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#166534"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMappingValid}" Value="False">
                                                <Setter Property="Foreground" Value="#991B1B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" CornerRadius="0,0,24,24" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border}">
                    <Grid>
                        <Button Content="VazgeÃ§" Command="{Binding CloseBookletMappingCommand}"
                                HorizontalAlignment="Left" Style="{StaticResource OutlineButton}" Padding="18,10"/>
                        
                        <Button Content="âš¡ AnahtarÄ± TÃ¼ret ve Ekle" Command="{Binding ApplyBookletMappingCommand}"
                                HorizontalAlignment="Right" Background="{DynamicResource AccentPurple}" Foreground="White"
                                FontWeight="SemiBold" Padding="20,10" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
