<UserControl x:Class="OptikFormApp.Views.Modals.BulkAnswerEntryModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="460">

    <Grid Visibility="{Binding IsBulkAnswerEntryOpen, Converter={StaticResource BoolToVis}}" 
          Background="{DynamicResource ModalBackdrop}">

        <Border MaxWidth="460"
                MaxHeight="520"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Margin="20,16"
                CornerRadius="14"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource FluentIconFont}" FontSize="15" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Toplu Cevap Girişi" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="1 A, 2 B veya doğrudan şık listesi biçiminde yapıştırın" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseBulkAnswerEntryCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- İçerik -->
                <StackPanel Grid.Row="2" Margin="20,16">
                    <Border CornerRadius="8" Padding="11,8" Margin="0,0,0,12" Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <TextBlock Text="Her satıra bir soru ('1 A', '2 C') gelecek şekilde yazabilir veya Excel'den kopyalayıp yapıştırabilirsiniz."
                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMain}"/>
                    </Border>

                    <TextBlock Text="Cevap Metni:" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextMain}"/>
                    <TextBox Text="{Binding BulkAnswerEntryText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Mono"
                             FontSize="13.5" Padding="10" Height="180" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="{Binding BulkAnswerPreview, StringFormat='Önizleme: {0}'}"
                               FontSize="11" Margin="0,10,0,0" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Alt Çubuk -->
                <Border Grid.Row="3" Padding="20,12" BorderThickness="0,1,0,0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Vazgeç (Esc)" Command="{Binding CloseBulkAnswerEntryCommand}" Style="{StaticResource OutlineButton}" Padding="16,7" FontSize="12" Margin="0,0,8,0"/>
                        <Button Content="Uygula" Command="{Binding ApplyBulkAnswerEntryCommand}" Background="{DynamicResource Accent}" Foreground="White" Padding="20,7" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
