<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme defaults (design-time + runtime fallback) -->
    <SolidColorBrush x:Key="AppBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMain" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextMuted" Color="#475569"/>
    <SolidColorBrush x:Key="Border" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="AltRowBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HoverBg" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="ModalBackdrop" Color="#800F172A"/>
    <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2563EB"/>
    <SolidColorBrush x:Key="Success" Color="#10B981"/>
    <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Error" Color="#EF4444"/>
    <SolidColorBrush x:Key="GlassCardBgColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GlassCardBorderColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShadowColor" Color="#000000"/>
    
    <!-- Ek arka plan / metin renkleri -->
    <SolidColorBrush x:Key="AccentBgLight" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="SuccessBgLight" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="WarningBgLight" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="ErrorBgLight" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentViolet" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#D97706"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#059669"/>
    <SolidColorBrush x:Key="AccentRed" Color="#B91C1C"/>
    <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
    <SolidColorBrush x:Key="AccentTeal" Color="#14B8A6"/>
    
    <!-- Color resources for Color= attributes (Light theme) -->
    <Color x:Key="AppBgColor">#F8FAFC</Color>
    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <Color x:Key="TextMainColor">#1E293B</Color>
    <Color x:Key="TextMutedColor">#475569</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="HeaderBgColor">#F1F5F9</Color>
    <Color x:Key="HoverBgColor">#EFF6FF</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#2563EB</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ShadowColorValue">#000000</Color>
    
    <!-- Ek Color kaynaklari -->
    <Color x:Key="AccentBgLightColor">#DBEAFE</Color>
    <Color x:Key="SuccessBgLightColor">#DCFCE7</Color>
    <Color x:Key="WarningBgLightColor">#FEF3C7</Color>
    <Color x:Key="ErrorBgLightColor">#FEE2E2</Color>
    <Color x:Key="AccentPurpleColor">#8B5CF6</Color>
    <Color x:Key="AccentVioletColor">#7C3AED</Color>
    <Color x:Key="AccentOrangeColor">#D97706</Color>
    <Color x:Key="AccentGreenColor">#059669</Color>
    <Color x:Key="AccentRedColor">#B91C1C</Color>
    <Color x:Key="AccentCyanColor">#06B6D4</Color>
    <Color x:Key="AccentTealColor">#14B8A6</Color>
</ResourceDictionary>