<UserControl x:Class="OptikFormApp.Views.StatusPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="160" d:DesignWidth="1100">
    <StackPanel>
        <!-- 1. DOĞRULAMA UYARI BANDI (Sadece hata varsa görünür) -->
        <Border Visibility="{Binding ValidationIssuesCount, Converter={StaticResource NumericToVis}}" 
                Background="{DynamicResource ErrorBgLight}" BorderBrush="{DynamicResource Error}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="{StaticResource FluentIconFont}" FontSize="13.5" Foreground="{DynamicResource Error}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                    <Run Text="{Binding ValidationIssuesCount, Mode=OneWay, StringFormat='{}{0} Adet Veri Doğrulama Uyarısı Tespit Edildi'}" FontWeight="Bold" Foreground="{DynamicResource Error}" FontSize="11.5"/>
                    <Run Text=" — Eksik kodlama veya okuma anomalilerini inceleyin." FontSize="11" Foreground="{DynamicResource TextMain}"/>
                </TextBlock>

                <Button Grid.Column="2" Padding="11,4" Background="{DynamicResource Error}" Foreground="White" FontWeight="SemiBold" FontSize="10.5"
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                        Command="{Binding ShowValidationDetailsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource FluentIconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Detayları İncele" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 2. AÇILIR/KAPANIR İŞLEM KAYITLARI (LOG) ÇEKMECESİ -->
        <Border Visibility="{Binding IsLogDrawerOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="108"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource FluentIconFont}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Sistem İşlem Kayıtları" FontWeight="Bold" Foreground="{DynamicResource TextMain}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Command="{Binding ToggleLogDrawerCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand" ToolTip="Kayıt Çekmecesini Kapat">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1.5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayTime}" FontFamily="Consolas, Cascadia Mono" Foreground="{DynamicResource TextMuted}" FontSize="10.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogLevelConverter}}" FontSize="11" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- 3. KURUMSAL İNCE ALT DURUM ÇUBUĞU (30px Sabit Yükseklik, Dar Ekran Korumalı) -->
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Height="30" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="Auto" MaxWidth="340"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Sistem Durumu -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Durum:" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMain}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                </Grid>

                <!-- Orta/Sağ: Kural Özeti -->
                <TextBlock Grid.Column="1" Text="{Binding GradingRulesSummary}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding GradingRulesSummary}"/>

                <!-- Sağ: Log Çekmecesi Butonu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Height="13" Background="{DynamicResource Border}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button Command="{Binding ToggleLogDrawerCommand}" Background="Transparent" BorderThickness="0" Padding="7,3" Cursor="Hand"
                            ToolTip="Sistem İşlem Kayıtlarını Aç / Kapat">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource FluentIconFont}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Logs.Count, StringFormat='İşlem Kayıtları ({0})'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
