<UserControl x:Class="OptikFormApp.Views.StudentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Search Bar and Quick Filter Pills -->
        <Grid Grid.Row="0" Margin="0,5,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Bar -->
            <Border Grid.Column="0" Background="{DynamicResource AltRowBg}" CornerRadius="10" Padding="15,8" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.5"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                             FontSize="13" Foreground="{DynamicResource TextMain}">
                        <TextBox.Resources>
                            <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Öğrenci adı veya numarası ile ara..."/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Quick Filter Pills -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Tümü" Command="{Binding SetQuickFilterCommand}" CommandParameter="All"
                        Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                <Button Content="🟢 Geçenler" Command="{Binding SetQuickFilterCommand}" CommandParameter="Passed"
                        Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                <Button Content="🟡 Şartlı" Command="{Binding SetQuickFilterCommand}" CommandParameter="Conditional"
                        Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                <Button Content="🔴 Kalanlar" Command="{Binding SetQuickFilterCommand}" CommandParameter="Failed"
                        Style="{StaticResource OutlineButton}" Padding="10,6" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding StudentsView}" RowHeight="{Binding GridRowHeight}"
                  Visibility="{Binding Students.Count, Converter={StaticResource DataToVisConverter}}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.IsContainerVirtualizable="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  ScrollViewer.CanContentScroll="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  Background="{DynamicResource CardBg}"
                  Foreground="{DynamicResource TextMain}"
                  RowBackground="{DynamicResource CardBg}"
                  AlternatingRowBackground="{DynamicResource AltRowBg}"
                  BorderThickness="0">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="{Binding DataContext.GridCellPadding, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" SortMemberPath="RowNumber" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ÖĞRENCİ NO" Binding="{Binding StudentId}" SortMemberPath="StudentId" Width="Auto"/>
                <DataGridTextColumn Header="AD SOYAD" Binding="{Binding FullName}" SortMemberPath="FullName" Width="1.5*"/>
                <DataGridTextColumn Header="KİTAPÇIK" Binding="{Binding BookletType}" SortMemberPath="BookletType" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <DataGridTemplateColumn Header="ÖĞRENCİ CEVAPLARI" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding ColoredAnswers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Character}" Foreground="{Binding State, Converter={StaticResource AnswerStateConverter}}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,0,1,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="D" Binding="{Binding CorrectCount}" SortMemberPath="CorrectCount" Width="45"/>
                <DataGridTextColumn Header="Y" Binding="{Binding IncorrectCount}" SortMemberPath="IncorrectCount" Width="45"/>
                <DataGridTextColumn Header="B" Binding="{Binding EmptyCount}" SortMemberPath="EmptyCount" Width="45"/>
                
                <DataGridTextColumn Header="NET" Binding="{Binding NetCount, StringFormat={}{0:N2}}" SortMemberPath="NetCount" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="PUAN" Binding="{Binding Score, StringFormat={}{0:N2}}" SortMemberPath="Score" Width="65">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="SIRA" Binding="{Binding Rank}" SortMemberPath="Rank" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- HARF NOTU ROZETİ -->
                <DataGridTemplateColumn Header="HARF" SortMemberPath="LetterGrade" Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="AA">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="BA">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="BB">
                                                <Setter Property="Background" Value="{DynamicResource AccentBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="CB">
                                                <Setter Property="Background" Value="{DynamicResource AccentBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="CC">
                                                <Setter Property="Background" Value="{DynamicResource WarningBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="DC">
                                                <Setter Property="Background" Value="{DynamicResource WarningBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="DD">
                                                <Setter Property="Background" Value="{DynamicResource WarningBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="FD">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LetterGrade}" Value="FF">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBgLight}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding LetterGrade}" FontWeight="Bold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="AA">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="BA">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="BB">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentViolet}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="CB">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentViolet}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="CC">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="DC">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="DD">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="FD">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LetterGrade}" Value="FF">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- DURUM ROZETİ -->
                <DataGridTemplateColumn Header="DURUM" SortMemberPath="Status" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Geçti">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Şartlı Geçti">
                                                <Setter Property="Background" Value="{DynamicResource WarningBgLight}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Kaldı">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBgLight}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Geçti">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Şartlı Geçti">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Kaldı">
                                                    <Setter Property="Foreground" Value="{DynamicResource Error}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- DETAY / İŞLEM -->
                <DataGridTemplateColumn Header="DETAY" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="👁️" ToolTip="Öğrenci Detayı / Düzenle"
                                    Command="{Binding DataContext.OpenStudentDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="13"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- EMPTY STATE -->
        <Border Grid.Row="1" Visibility="{Binding Students.Count, Converter={StaticResource CountToVisConverter}}" 
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
            <StackPanel>
                <Border Width="80" Height="80" Background="{DynamicResource AltRowBg}" CornerRadius="40" Margin="0,0,0,20">
                    <TextBlock Text="📂" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Kayıtlı Öğrenci Bulunamadı" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                <TextBlock Text="Henüz bir optik veri dosyası yüklenmemiş veya filtrelere uygun kayıt yok." FontSize="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,10,0,25" TextAlignment="Center"/>
                <Button Content="Dosya Yükle (Ctrl+O)" Command="{Binding LoadTxtCommand}" Style="{StaticResource PipelineButton}" 
                        Background="{DynamicResource Accent}" Foreground="White" Padding="25,12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
