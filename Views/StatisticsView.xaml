<UserControl x:Class="OptikFormApp.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="14,10,14,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Kurumsal Başlık & Gelişmiş Madde Analizi Aksiyonu -->
        <Grid Grid.Row="0" Margin="0,2,0,12" Visibility="{Binding Statistics.Count, Converter={StaticResource DataToVisConverter}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource HoverBg}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource FluentIconFont}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Soru Bazlı Şık Dağılımı ve Madde İstatistikleri" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    <TextBlock Text="Her sorunun doğru, yanlış, boş yüzdeleri ve A–E şıklarının işaretlenme frekansları" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding OpenItemAnalysisCommand}"
                    Style="{StaticResource OutlineButton}" Padding="12,6" FontSize="11.5" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource FluentIconFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Detaylı Psikometrik &amp; Çeldirici Analizi" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Statistics}" RowHeight="{Binding GridRowHeight}"
                  Visibility="{Binding Statistics.Count, Converter={StaticResource DataToVisConverter}}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="{Binding DataContext.GridCellPadding, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="KİTAPÇIK" Binding="{Binding Booklet}" Width="75">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SORU" Binding="{Binding QuestionNumber}" Width="65">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ANAHTAR" Binding="{Binding CorrectAnswer}" Width="75">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="ExtraBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <DataGridTextColumn Header="% DOĞRU" Binding="{Binding CorrectPercent, StringFormat={}{0:N1}%}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="% YANLIŞ" Binding="{Binding IncorrectPercent, StringFormat={}{0:N1}%}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Foreground" Value="{DynamicResource Error}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="% BOŞ" Binding="{Binding EmptyPercent, StringFormat={}{0:N1}%}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="A ŞIKKI" Binding="{Binding CountA}" Width="70"/>
                <DataGridTextColumn Header="B ŞIKKI" Binding="{Binding CountB}" Width="70"/>
                <DataGridTextColumn Header="C ŞIKKI" Binding="{Binding CountC}" Width="70"/>
                <DataGridTextColumn Header="D ŞIKKI" Binding="{Binding CountD}" Width="70"/>
                <DataGridTextColumn Header="E ŞIKKI" Binding="{Binding CountE}" Width="70"/>
                <DataGridTextColumn Header="BOŞ" Binding="{Binding CountEmpty}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- EMPTY STATE -->
        <Border Grid.Row="1" Visibility="{Binding Statistics.Count, Converter={StaticResource CountToVisConverter}}" 
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500" Padding="24">
            <StackPanel>
                <Border Width="68" Height="68" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource FluentIconFont}" FontSize="28" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Madde Analiz Verisi Bulunmuyor" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                <TextBlock Text="Soru ve şık istatistiklerini hesaplamak için cevap anahtarını doğrulayıp Hesapla (F5) işlemini çalıştırın."
                           FontSize="12.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,20" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Command="{Binding EvaluateCommand}" Style="{StaticResource PipelineButton}" 
                        Background="{DynamicResource AccentViolet}" BorderBrush="{DynamicResource AccentViolet}" Foreground="White" Padding="22,10" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource FluentIconFont}" FontSize="12.5" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Puanları ve Analizi Hesapla (F5)" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
