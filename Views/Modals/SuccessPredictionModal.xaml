<UserControl x:Class="OptikFormApp.Views.Modals.SuccessPredictionModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OptikFormApp.Views"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="920">

    <Grid Visibility="{Binding IsSuccessPredictionOpen, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource ModalBackdrop}">

        <Border MaxWidth="940"
                MaxHeight="660"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="20,16"
                CornerRadius="14"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.24" BlurRadius="45" ShadowDepth="12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- 1. Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource FluentIconFont}" FontSize="15.5" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Akademik Başarı ve Risk Projeksiyonu" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="Belirlenen baraj puanına göre öğrenci geçme olasılıkları ve akademik risk analizi" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseSuccessPredictionCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Özet KPI Kartları -->
                <views:ResponsiveUniformGrid Grid.Row="2" MaxColumns="4" MinColumns="2" MinColumnWidth="170" Margin="16,12,16,6">
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="TOPLAM ÖĞRENCİ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding ClassPredictionSummary.TotalStudents}" FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource TextMain}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="TAHMİNİ GEÇME ORANI" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding ClassPredictionSummary.PassRate, StringFormat={}{0:P0}}" FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Success}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="YÜKSEK RİSK GRUBU" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding ClassPredictionSummary.HighRiskCount}" FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Error}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="ORTALAMA TAHMİNİ PUAN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding ClassPredictionSummary.AveragePredictedScore, StringFormat={}{0:F1}}" FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </views:ResponsiveUniformGrid>

                <!-- 3. Baraj Puanı Ayarlayıcı -->
                <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="14,9" Margin="20,2,20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hedef Geçme (Baraj) Puanı:" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,14,0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PassingScore}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" CornerRadius="6" Padding="10,4" Margin="12,0,0,0" Background="{DynamicResource Accent}">
                            <TextBlock Text="{Binding PassingScore, Mode=OneWay, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="12.5"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 4. Tablo -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Margin="20,0,20,12" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding StudentPredictions}" AutoGenerateColumns="False" IsReadOnly="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              GridLinesVisibility="None" HeadersVisibility="Column" Background="{DynamicResource CardBg}" BorderThickness="0" CanUserSortColumns="True" RowHeight="34">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Risk}" Value="High">
                                        <Setter Property="Background" Value="{DynamicResource ErrorBgLight}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                        <Setter Property="Background" Value="{DynamicResource WarningBgLight}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ÖĞRENCİ NO" Binding="{Binding StudentId}" Width="105"/>
                            <DataGridTextColumn Header="AD SOYAD" Binding="{Binding FullName}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="MEVCUT PUAN" Binding="{Binding CurrentScore, StringFormat={}{0:F1}}" Width="95"/>
                            <DataGridTextColumn Header="TAHMİNİ PUAN" Binding="{Binding PredictedScore, StringFormat={}{0:F1}}" Width="98"/>
                            <DataGridTextColumn Header="GEÇME OLASILIĞI" Binding="{Binding GradeProbability, StringFormat={}{0:P0}}" Width="115"/>
                            <DataGridTextColumn Header="GÜVEN" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="72"/>
                            <DataGridTextColumn Header="RİSK DURUMU" Binding="{Binding RiskDescription}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 5. Alt Çubuk -->
                <Border Grid.Row="5" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding RunSuccessPredictionCommand}" Style="{StaticResource OutlineButton}" Padding="14,7" FontSize="12" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Yeniden Hesapla" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Kapat" Command="{Binding CloseSuccessPredictionCommand}" IsDefault="True"
                                Background="{DynamicResource Accent}" Foreground="White" Padding="24,7" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
