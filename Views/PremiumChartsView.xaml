<UserControl x:Class="OptikFormApp.Views.PremiumChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1100">
    
    <UserControl.Resources>
        <!-- Chart Animasyonları -->
        <Storyboard x:Key="ChartFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                           From="0" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.05" BlurRadius="18" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniStatBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <!-- VERİ VAR DURUMU -->
        <ScrollViewer x:Name="ChartScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Students.Count, Converter={StaticResource DataToVisConverter}}">
            <StackPanel Margin="24">
                
                <!-- 1. PUAN DAĞILIMI VE GAUSSIAN NORMAL DAĞILIM (Ã‡AN EĞRİSİ) -->
                <Border Style="{StaticResource ChartCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="280"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- BaÅŸlık & Rozetler -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBgLight}" Margin="0,0,12,0">
                                    <TextBlock Text="ğŸ“ˆ" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Puan DaÄŸılımı ve Gauss Ã‡an EÄŸrisi (Normal DaÄŸılım)" 
                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="Ã–ÄŸrenci puanlarının frekans çubukları ile teorik çan eÄŸrisi uyumu" 
                                               FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Mini Ã–zet Rozetleri -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Style="{StaticResource MiniStatBadge}" Background="{DynamicResource SuccessBgLight}" BorderBrush="{DynamicResource SuccessBgLight}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ortalama: " FontSize="11" Foreground="{DynamicResource Success}"/>
                                        <TextBlock Text="{Binding ClassGradingStats.MeanScore, StringFormat={}{0:F1}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MiniStatBadge}" Background="{DynamicResource WarningBgLight}" BorderBrush="{DynamicResource WarningBgLight}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Medyan: " FontSize="11" Foreground="{DynamicResource Warning}"/>
                                        <TextBlock Text="{Binding ClassStats.MedianScore, StringFormat={}{0:F1}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Warning}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MiniStatBadge}" Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource AccentBgLight}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sapma: " FontSize="11" Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="{Binding ClassGradingStats.StandardDeviation, StringFormat={}Â±{0:F1}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Gösterge Lejantı -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <Border Width="14" Height="14" Background="{DynamicResource Accent}" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="Ã–ÄŸrenci Puan Sayısı (Frekans)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="3" Background="{DynamicResource Error}" CornerRadius="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Teorik Normal DaÄŸılım Ã‡an EÄŸrisi (Gaussian)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Ã‡izim Canvas Alanı -->
                        <Border Grid.Row="2" Name="BellCurveHost" Background="Transparent" ClipToBounds="True"/>

                        <!-- X Ekseni Alt Açıklamaları -->
                        <Grid Grid.Row="3" Margin="40,8,40,0">
                            <TextBlock Text="0 (En DüÅŸük)" HorizontalAlignment="Left" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="50 (Baraj / Orta)" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="100 (Tam Puan)" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. HARF NOTU DAĞILIMI (BDS Ã‡AN EĞRİSİ NOTLARI) -->
                <Border Style="{StaticResource ChartCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="240"/>
                        </Grid.RowDefinitions>

                        <!-- BaÅŸlık -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBgLight}" Margin="0,0,12,0">
                                    <TextBlock Text="ğŸ“" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Harf Notu DaÄŸılımı (YÃ–K BaÄŸıl DeÄŸerlendirme)" 
                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="BaÄŸıl T-Skoru veya mutlak sisteme göre öÄŸrenci harf notu yelpazesi" 
                                               FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border HorizontalAlignment="Right" Background="{DynamicResource AccentBgLight}" BorderBrush="{DynamicResource AccentBgLight}" BorderThickness="1" CornerRadius="10" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sınıf Düzeyi: " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding ClassGradingStats.ClassLevelDescription}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Harf Notu Ã‡ubuk Ã‡izim Alanı -->
                        <Border Grid.Row="1" Name="GradeDistributionHost" Background="Transparent" ClipToBounds="True"/>
                    </Grid>
                </Border>

                <!-- 3. SORU BAŞARI PROFİLİ (DOĞRU / YANLIŞ / BOŞ ORANLARI) -->
                <Border Style="{StaticResource ChartCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="270"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SuccessBgLight}" Margin="0,0,12,0">
                                    <TextBlock Text="ğŸ“Š" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Soru BaÅŸarı Profili (% DoÄŸru, YanlıÅŸ ve BoÅŸ)" 
                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="Soru bazında baÅŸarı yüzdeleri ve öÄŸrenci tercih yoÄŸunlukları" 
                                               FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                <Border Width="12" Height="12" Background="{DynamicResource Success}" CornerRadius="3" Margin="0,0,5,0"/>
                                <TextBlock Text="DoÄŸru Yanıt" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                <Border Width="12" Height="12" Background="{DynamicResource Error}" CornerRadius="3" Margin="0,0,5,0"/>
                                <TextBlock Text="YanlıÅŸ Yanıt" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Background="{DynamicResource TextMuted}" CornerRadius="3" Margin="0,0,5,0"/>
                                <TextBlock Text="BoÅŸ Bırakılan" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Soru BaÅŸarı Canvas -->
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Border Name="QuestionSuccessHost" Background="Transparent" MinWidth="800" Height="260"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 4. MADDE AYIRT EDİCİLİK İNDEKSİ & KİTAPÃ‡IK ANALİZİ YAN YANA -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Madde Ayırt Edicilik DaÄŸılımı -->
                    <Border Grid.Column="0" Style="{StaticResource ChartCard}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="200"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource ErrorBgLight}" Margin="0,0,10,0">
                                        <TextBlock Text="ğŸ¯" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Madde Ayırt Edicilik Kalitesi (r_pbi)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="Soruların baÅŸarılı ve zayıf öÄŸrencileri ayırt etme gücü" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1" Name="DiscriminationQualityHost" Background="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Kitapçık Performansı -->
                    <Border Grid.Column="1" Style="{StaticResource ChartCard}" Margin="12,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="200"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentBgLight}" Margin="0,0,10,0">
                                        <TextBlock Text="ğŸ“š" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Kitapçık Performans Dengesi" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="Farklı kitapçıkların ortalama puan ve katılım dengesi" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1" Name="BookletComparisonHost" Background="Transparent"/>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- VERİ YOK DURUMU (EMPTY STATE) -->
        <Border Visibility="{Binding Students.Count, Converter={StaticResource CountToVisConverter}}" 
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Padding="30">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="90" Height="90" Background="{DynamicResource AltRowBg}" CornerRadius="45" Margin="0,0,0,24" HorizontalAlignment="Center">
                    <TextBlock Text="ğŸ“ˆ" FontSize="46" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Grafiksel Analiz Verisi Bulunamadı" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Gauss çan eÄŸrisi, harf notu daÄŸılımı ve soru baÅŸarı profillerini görüntülemek için öÄŸrenci verisi yükleyip 'Hesapla (F5)' butonuna basınız." 
                           FontSize="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,24" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Content="âš¡ Puanları Hesapla (F5)" Command="{Binding EvaluateCommand}" Style="{StaticResource PipelineButton}" 
                        Background="{DynamicResource AccentViolet}" Foreground="White" Padding="25,12" HorizontalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
