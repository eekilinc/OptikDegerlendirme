<UserControl x:Class="OptikFormApp.Views.OutcomesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OptikFormApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="880">
    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve Düzenleme Butonu (Responsive) -->
        <local:ResponsiveToolbarPanel Grid.Row="0" StretchFirst="True" MinFirstWidth="260" HorizontalSpacing="12" VerticalSpacing="8" Margin="0,0,0,12"
                                      Visibility="{Binding LearningOutcomes.Count, Converter={StaticResource DataToVisConverter}}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource HoverBg}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource FluentIconFont}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Öğrenim Çıktıları ve Konu Başarı Analizi" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="YÖKAK / Akreditasyon uyumlu konu ve kazanım gerçekleşme düzeyleri" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <Button VerticalAlignment="Center" Command="{Binding OpenLearningOutcomesCommand}"
                    Style="{StaticResource OutlineButton}" Padding="11,6" FontSize="11" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Kazanımları Düzenle" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </local:ResponsiveToolbarPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding LearningOutcomes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Margin="0,0,0,10" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Border Background="{DynamicResource AccentBgLight}" CornerRadius="4" Padding="6,2" Margin="0,0,10,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BookletName, StringFormat='Kitapçık {0}'}" Foreground="{DynamicResource Accent}" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                    
                                    <TextBlock Text="{Binding QuestionNumbersRaw, StringFormat='İlgili Sorular: {0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{Binding GlobalSuccessRate, StringFormat='Genel Sınıf Başarısı: %{0:F1}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                        <Grid Height="6" Background="{DynamicResource HeaderBg}" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource Accent}" HorizontalAlignment="Left" CornerRadius="3">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource MultiValuePercentageConverter}">
                                                        <Binding Path="GlobalSuccessRate"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding SuccessRate, StringFormat='Kitapçık İçi Başarı: %{0:F1}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                        <Grid Height="6" Background="{DynamicResource HeaderBg}">
                                            <Border Background="{DynamicResource Success}" HorizontalAlignment="Left" CornerRadius="3">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource MultiValuePercentageConverter}">
                                                        <Binding Path="SuccessRate"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding GlobalSuccessRate, StringFormat='{}%{0:F1}'}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Genel Başarı" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" Margin="0,-2,0,4"/>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding CorrectCount}" FontWeight="Bold" Foreground="{DynamicResource TextMain}" FontSize="11"/>
                                        <TextBlock Text="/" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding TotalQuestions}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text=" Doğru Yanıt" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- EMPTY STATE -->
        <Border Grid.Row="1" Visibility="{Binding LearningOutcomes.Count, Converter={StaticResource CountToVisConverter}}" 
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500" Padding="20">
            <StackPanel>
                <Border Width="64" Height="64" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="15" Margin="0,0,0,14" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource FluentIconFont}" FontSize="26" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Öğrenim Çıktısı Tanımlanmadı" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                <TextBlock Text="YÖKAK / Akreditasyon uyumlu konu ve kazanım başarı raporlarını oluşturmak için sınav sorularını dersin öğrenim çıktılarıyla eşleştirin."
                           FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,18" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Command="{Binding OpenLearningOutcomesCommand}" Style="{StaticResource PipelineButton}" 
                        Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="White" Padding="20,9" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource FluentIconFont}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Öğrenim Çıktılarını Tanımla" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
