<UserControl x:Class="OptikFormApp.Views.Modals.AboutModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="580">
    
    <Grid Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVis}}" 
          Background="{DynamicResource ModalBackdrop}">
        
        <!-- Premium Modal Container -->
        <Border Width="560" 
                MaxHeight="560"
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                CornerRadius="20"
                Padding="0"
                Margin="20"
                Background="{DynamicResource CardBg}">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.25" BlurRadius="50" ShadowDepth="15"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Premium Header with Gradient -->
                <Border Grid.Row="0" 
                        CornerRadius="20,20,0,0" 
                        Height="90"
                        Padding="24,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource AccentPurpleColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentVioletColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Logo Container -->
                        <Border Grid.Column="0" 
                                Width="54" 
                                Height="54" 
                                CornerRadius="12" 
                                Background="White"
                                Margin="0,0,16,0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="10" ShadowDepth="3"/>
                            </Border.Effect>
                            <Image Source="/Assets/app_logo.png" Stretch="Uniform" Margin="6"/>
                        </Border>
                        
                        <!-- Header Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="AĞLASUN MESLEK YÜKSEKOKULU" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       Opacity="0.85"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Optik Değerlendirme &amp; İstatistik" 
                                       FontSize="17" 
                                       FontWeight="Bold" 
                                       Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Background="#30FFFFFF" CornerRadius="4" Padding="6,1.5">
                                    <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0} PRO Enterprise'}" 
                                               FontSize="10" 
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2" 
                                Command="{Binding CloseAboutCommand}"
                                VerticalAlignment="Top"
                                Width="30" 
                                Height="30" 
                                Background="#25FFFFFF"
                                Foreground="White"
                                FontSize="13"
                                Cursor="Hand">
                            <Button.Content>✕</Button.Content>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Modern Tab Control -->
                <TabControl Grid.Row="1" 
                            Margin="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="TabBorder" 
                                                Padding="20,10" 
                                                BorderThickness="0,0,0,2"
                                                BorderBrush="Transparent"
                                                Background="Transparent"
                                                Cursor="Hand">
                                            <TextBlock Name="TabText"
                                                       Text="{TemplateBinding Header}"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMuted}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentPurple}"/>
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource AccentPurple}"/>
                                                <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextMain}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- TAB 1: GENEL BAKIŞ -->
                    <TabItem Header="📌 Genel Bakış">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                            <StackPanel>
                                <!-- Hero Card -->
                                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentBgLight}" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                                <TextBlock Text="🏛️ Ağlasun Meslek Yüksekokulu" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SuccessBgLight}" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="✓ YÖK BDS Uyumlu" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="Yeni Nesil Optik Sınav Değerlendirme &amp; İstatistik Platformu" 
                                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2" Text="OMR optik tarayıcı çıktılarını (.txt, .dat) saniyeler içinde işleyen, bağıl değerlendirme sistemi (BDS) çan eğrisi notlandırması yapan, güvenilirlik ve madde analizleri üreten kurumsal masaüstü yazılımı." 
                                                   FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                    </Grid>
                                </Border>

                                <!-- 4 Adımlı İş Akışı -->
                                <TextBlock Text="Uçtan Uca Değerlendirme Süreci" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="2,0,0,8"/>
                                
                                <UniformGrid Columns="4" Margin="0,0,0,14">
                                    <!-- Adım 1 -->
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,10" Margin="0,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource HoverBg}" Margin="0,0,0,6">
                                                <TextBlock Text="📂" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="1. Veri Yükle" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="TXT/DAT Form" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Adım 2 -->
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,10" Margin="2,0,2,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBgLight}" Margin="0,0,0,6">
                                                <TextBlock Text="🔑" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="2. Anahtar Eşle" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="A, B, C, D Matrisi" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Adım 3 -->
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,10" Margin="2,0,2,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource WarningBgLight}" Margin="0,0,0,6">
                                                <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="3. Çan &amp; Not" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="T-Skor &amp; Harf" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Adım 4 -->
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,10" Margin="4,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessBgLight}" Margin="0,0,0,6">
                                                <TextBlock Text="📑" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="4. Raporla" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="PDF &amp; Excel" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Temel Standartlar & Güvenlik Özeti -->
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="Sistem Güvencesi ve Standartlar" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,6"/>
                                        
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🛡️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="%100 Çevrimdışı (Offline): Öğrenci verileri asla buluta gitmez, cihazda kalır." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📊" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Psikometri: KR-20, SeM, Varyans ve Madde Ayırt Edicilik analizleri." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="💾" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Yerel Depolama: Sınav geçmişi ve ders arşivleri SQLite veritabanında saklanır." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- TAB 2: ÖZELLİKLER & MODÜLLER -->
                    <TabItem Header="🚀 Modüller">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                            <StackPanel>
                                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔑" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Akıllı Çoklu Kitapçık &amp; Eşleme Matrisi" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="A, B, C, D kitapçıklarını tek tuşla ana kitapçığa dönüştürür ve eşler." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📝" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Gelişmiş Soru &amp; İptal Yönetimi" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="Hatalı soruları iptal etme veya çoklu doğru şık belirleme desteği." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎯" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Öğrenim Çıktıları &amp; Konu Analizi" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="Müfredat ve program yeterliliklerine göre başarı yüzdelerini raporlar." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🛡" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Çevrimdışı Güvenlik &amp; Yedekleme" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="Tüm veriler cihazınızda yerel SQLite veritabanında şifreli saklanır." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: GELİŞTİRİCİ & KÜNYE -->
                    <TabItem Header="👨‍💻 Geliştirici &amp; Künye">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                            <StackPanel HorizontalAlignment="Center" Width="480">
                                <Border Width="60" 
                                        Height="60" 
                                        CornerRadius="30" 
                                        Background="{DynamicResource AccentBgLight}"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="🎓" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <TextBlock Text="Burdur Mehmet Akif Ersoy Üniversitesi" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextMuted}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="AĞLASUN MESLEK YÜKSEKOKULU" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TextMain}" 
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,14"/>

                                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Proje Lideri:" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Öğr. Gör. Ekrem KILINÇ" FontWeight="Bold" Foreground="{DynamicResource TextMain}" FontSize="12" Margin="0,3"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Teknoloji Mimarisi:" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 9.0 • WPF • C# 13 • MVVM" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,3"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="İletişim &amp; Destek:" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="ekilinc@mehmetakif.edu.tr" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" FontSize="12" Margin="0,3"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                
                <!-- Modern Footer -->
                <Border Grid.Row="2" 
                        CornerRadius="0,0,20,20" 
                        Padding="24,14"
                        Background="{DynamicResource HeaderBg}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="© 2026 Ağlasun Meslek Yüksekokulu. Tüm hakları saklıdır." 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"/>
                        
                        <Button Content="Kapat" 
                                Command="{Binding CloseAboutCommand}"
                                HorizontalAlignment="Right" 
                                Background="{DynamicResource AccentPurple}" 
                                Foreground="White"
                                Padding="24,8" 
                                FontSize="12" 
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentViolet}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>