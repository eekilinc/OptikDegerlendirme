<UserControl x:Class="OptikFormApp.Views.Modals.LearningOutcomesModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="680">

    <Grid Visibility="{Binding IsLearningOutcomesOpen, Converter={StaticResource BoolToVis}}" 
          Background="{DynamicResource ModalBackdrop}">

        <Border MaxWidth="680"
                MaxHeight="650"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Margin="20,16"
                CornerRadius="14"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource FluentIconFont}" FontSize="15.5" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Öğrenim Çıktıları ve Konu Yönetimi" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="YÖKAK / Akreditasyon uyumlu kazanım analizleri için soru aralıklarını tanımlayın" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseLearningOutcomesCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Yeni Kazanım Ekleme Formu -->
                <Border Grid.Row="2" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="20,14,20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kazanım / Konu Başlığı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewOutcomeName, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" FontSize="12.5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kitapçık" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                            <ComboBox SelectedItem="{Binding NewOutcomeBooklet}" Padding="10,7" FontSize="12.5">
                                <ComboBoxItem>A</ComboBoxItem>
                                <ComboBoxItem>B</ComboBoxItem>
                                <ComboBoxItem>C</ComboBoxItem>
                                <ComboBoxItem>D</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Sorular (Örn: 1-5)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewOutcomeRange, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" FontSize="12.5"/>
                        </StackPanel>

                        <Button Grid.Column="6" Command="{Binding AddLearningOutcomeCommand}" VerticalAlignment="Bottom"
                                Background="{DynamicResource Success}" Foreground="White" Padding="14,8" FontSize="12" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ekle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Kazanım Tablosu -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Margin="20,0,20,14" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding LearningOutcomes}" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="{DynamicResource CardBg}" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="None" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KONU / KAZANIM BAŞLIĞI" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="KİTAPÇIK" Binding="{Binding BookletName}" Width="85" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SORU ARALIĞI" Binding="{Binding QuestionNumbersRaw}" Width="125" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="İŞLEM" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveLearningOutcomeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource OutlineButton}" BorderBrush="{DynamicResource Error}" Foreground="{DynamicResource Error}"
                                                Padding="10,4" FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FluentIconFont}" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sil" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Alt Çubuk -->
                <Border Grid.Row="4" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Button Content="Tamam" Command="{Binding CloseLearningOutcomesCommand}" IsDefault="True"
                            HorizontalAlignment="Right" Background="{DynamicResource Accent}" Foreground="White" Padding="24,8" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
