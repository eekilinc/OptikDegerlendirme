<UserControl x:Class="OptikFormApp.Views.Modals.RosterMatchModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="820">

    <Grid Visibility="{Binding IsRosterMatchOpen, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource ModalBackdrop}">
        <Border MaxWidth="840" MaxHeight="650" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                CornerRadius="20" Background="{DynamicResource CardBg}" Margin="20,16">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.25" BlurRadius="50" ShadowDepth="15"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Height="76" CornerRadius="20,20,0,0" Padding="24,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource AccentPurpleColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentVioletColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#25FFFFFF" Margin="0,0,14,0">
                                <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sınıf Listesi Eşleştirme &amp; Yoklama Analizi" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="OBS sınıf listesiyle karşılaştırarak sınava girmeyenleri (G) ve yanlış numara kodlayanları tespit edin" FontSize="11" Foreground="White" Opacity="0.85"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Command="{Binding CloseRosterMatchCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="30" Height="30" Background="#25FFFFFF" Foreground="White" FontSize="13" Cursor="Hand">
                            <Button.Content>✕</Button.Content>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Dosya Seçim ve Özet Bar -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RosterFileName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="{Binding RosterMatchSummary}" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding LoadRosterFileCommand}" Style="{StaticResource PipelineButton}"
                                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="White"
                                Padding="14,8" FontSize="12" FontWeight="Bold" Content="📂 Sınıf Listesi Yükle (.xlsx / .csv)"/>
                    </Grid>
                </Border>

                <!-- Sonuç Sekmeleri -->
                <TabControl Grid.Row="2" Margin="18,12" Background="Transparent" BorderThickness="0">
                    <!-- 1. Yanlış Numara Kodlayanlar (Fuzzy Eşleşme) -->
                    <TabItem Header="🔍 Yanlış Numara Şüphesi (Düzelt)">
                        <DataGrid ItemsSource="{Binding SuspectedMismatches}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,8,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Optik No" Binding="{Binding OpticalId}" Width="105"/>
                                <DataGridTextColumn Header="Optik İsim" Binding="{Binding OpticalName}" Width="*"/>
                                <DataGridTextColumn Header="Önerilen No" Binding="{Binding SuggestedRosterId}" Width="105">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Listedeki İsim" Binding="{Binding SuggestedRosterName}" Width="*"/>
                                <DataGridTextColumn Header="Benzerlik" Binding="{Binding SimilarityPercent, StringFormat='{}%{0:F0}'}" Width="70"/>
                                <DataGridTemplateColumn Header="İşlem" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✓ Düzelt"
                                                    Command="{Binding DataContext.ApplySuspectedFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource Success}" Foreground="White" Padding="8,4" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- 2. Sınava Girmeyenler (G) -->
                    <TabItem Header="⚠️ Sınava Girmeyenler (G)">
                        <DataGrid ItemsSource="{Binding AbsentStudents}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,8,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Öğrenci No" Binding="{Binding StudentId}" Width="140"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- 3. Listede Olmayan Optik Kayıtlar -->
                    <TabItem Header="❓ Listede Olmayanlar (Misafir)">
                        <DataGrid ItemsSource="{Binding UnlistedOpticalStudents}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,8,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Optik No" Binding="{Binding StudentId}" Width="130"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Puan" Binding="{Binding Score, StringFormat='{}{0:F2}'}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <!-- Footer -->
                <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,20,20" Padding="20,12">
                    <Grid>
                        <Button Command="{Binding ExportAbsentStudentsCommand}" Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Left" Padding="14,7" FontSize="12" Content="📄 Girmeyenleri CSV Olarak İndir"/>
                        <Button Command="{Binding CloseRosterMatchCommand}" HorizontalAlignment="Right"
                                Background="{DynamicResource AccentPurple}" Foreground="White" Padding="22,7" FontSize="12" FontWeight="Bold" Content="Kapat"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
