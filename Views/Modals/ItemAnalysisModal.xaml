<UserControl x:Class="OptikFormApp.Views.Modals.ItemAnalysisModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OptikFormApp.Views"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="1020">
    <Grid Visibility="{Binding IsItemAnalysisOpen, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource ModalBackdrop}">
        <Border MaxWidth="1040"
                MaxHeight="700"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="20,16"
                CornerRadius="14"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.24" BlurRadius="45" ShadowDepth="12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- 1. Kurumsal Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource FluentIconFont}" FontSize="15.5" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Psikometrik Madde ve Çeldirici Analizi" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="KR-20 güvenilirliği, madde ayırt edicilik indeksleri ve üst/alt %27 çeldirici dağılımı" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseItemAnalysisCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Güvenirlik Özet Kartları -->
                <views:ResponsiveUniformGrid Grid.Row="2" MaxColumns="3" MinColumns="1" MinColumnWidth="200" Margin="16,12,16,6">
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="KR-20 GÜVENİRLİK" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding ReliabilityStats.KR20, StringFormat={}{0:F3}}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="CRONBACH ALFA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding ReliabilityStats.CronbachAlpha, StringFormat={}{0:F3}}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource AccentViolet}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="ANALİZ EDİLEN SORU" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding ReliabilityStats.QuestionCount}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource TextMain}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </views:ResponsiveUniformGrid>

                <!-- 3. Sekmeli İçerik -->
                <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="20,4,20,12">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Padding="14,8" Margin="0,0,6,0" CornerRadius="8,8,0,0" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Cursor="Hand">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HeaderBg}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent}"/>
                                                <Setter Property="TextElement.FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMuted}"/>
                                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- TAB 1: Madde Analizi & Anomaliler -->
                    <TabItem Header="Madde İstatistikleri ve Anomaliler">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0.44*" MinWidth="210" MaxWidth="320"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" ClipToBounds="True">
                                <DataGrid ItemsSource="{Binding QuestionStats}" AutoGenerateColumns="False" IsReadOnly="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          GridLinesVisibility="None" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="34">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProblematic}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorBgLight}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SORU" Binding="{Binding QuestionNumber}" Width="55"/>
                                        <DataGridTextColumn Header="ZORLUK" Binding="{Binding Difficulty, StringFormat={}{0:P0}}" Width="72"/>
                                        <DataGridTextColumn Header="AYIRT." Binding="{Binding Discrimination, StringFormat={}{0:F2}}" Width="72"/>
                                        <DataGridTextColumn Header="DOĞRU" Binding="{Binding CorrectRate, StringFormat={}{0:P0}}" Width="70"/>
                                        <DataGridTextColumn Header="BOŞ" Binding="{Binding EmptyRate, StringFormat={}{0:P0}}" Width="60"/>
                                        <DataGridTextColumn Header="PB KOREL." Binding="{Binding PointBiserialCorrelation, StringFormat={}{0:F2}}" Width="85"/>
                                        <DataGridTextColumn Header="DEĞERLENDİRME" Binding="{Binding Recommendation}" Width="*" MinWidth="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FluentIconFont}" FontSize="13.5" Foreground="{DynamicResource Error}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Tespit Edilen Anomaliler" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Anomalies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextMain}"/>
                                                            <TextBlock Text="{Binding StudentId}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource Error}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBlock Grid.Row="1" Text="Anomali tespit edilmedi." HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                                               Visibility="{Binding Anomalies.Count, Converter={StaticResource CountToVisConverter}}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: Çeldirici Analizi -->
                    <TabItem Header="Çeldirici Analizi (Üst / Alt %27)">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.35*" MinWidth="175" MaxWidth="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Soru Listesi" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,8"/>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding DistractorStats}" SelectedItem="{Binding SelectedDistractorQuestion}"
                                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="7" Padding="9,6" Margin="0,2" BorderThickness="1" BorderBrush="{DynamicResource Border}" Background="{DynamicResource CardBg}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextMain}">
                                                                <Run Text="Soru "/>
                                                                <Run Text="{Binding QuestionNumber, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}">
                                                                <Run Text="Anahtar: "/>
                                                                <Run Text="{Binding CorrectAnswer, Mode=OneWay}" FontWeight="Bold"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Visibility="{Binding HasMisleadingDistractor, Converter={StaticResource BoolToVis}}"
                                                                Background="{DynamicResource ErrorBgLight}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="Ters Çeldirici" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Error}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center">
                                            <Run Text="Soru "/>
                                            <Run Text="{Binding SelectedDistractorQuestion.QuestionNumber, Mode=OneWay}"/>
                                            <Run Text=" — Seçenek ve Çeldirici Dağılımı"/>
                                        </TextBlock>
                                        <Border Grid.Column="1" Background="{DynamicResource AccentBgLight}" CornerRadius="6" Padding="10,3">
                                            <TextBlock Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11.5">
                                                <Run Text="Doğru Şık: "/>
                                                <Run Text="{Binding SelectedDistractorQuestion.CorrectAnswer, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding SelectedDistractorQuestion.Options}" AutoGenerateColumns="False" IsReadOnly="True"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="34">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ŞIK" Binding="{Binding Option}" FontWeight="Bold" Width="55"/>
                                            <DataGridTemplateColumn Header="TÜR" Width="85">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="5" Padding="6,2" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBgLight}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10.5" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Çeldirici"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                                                <Setter Property="Text" Value="Doğru Şık"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Üst %27 (Kişi)" Width="88" Binding="{Binding TopCount, StringFormat={}{0} kişi}"/>
                                            <DataGridTextColumn Header="Üst %27 (%)" Width="82" Binding="{Binding TopPercent, StringFormat={}{0:F1}%}"/>
                                            <DataGridTextColumn Header="Alt %27 (Kişi)" Width="88" Binding="{Binding BottomCount, StringFormat={}{0} kişi}"/>
                                            <DataGridTextColumn Header="Alt %27 (%)" Width="82" Binding="{Binding BottomPercent, StringFormat={}{0:F1}%}"/>
                                            <DataGridTextColumn Header="Toplam" Width="62" Binding="{Binding TotalCount}"/>
                                            <DataGridTextColumn Header="Genel %" Width="75" Binding="{Binding TotalPercent, StringFormat={}{0:F1}%}"/>
                                            <DataGridTemplateColumn Header="DEĞERLENDİRME" Width="*" MinWidth="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="5" Padding="7,2" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Quality}" Value="MisleadingDistractor">
                                                                            <Setter Property="Background" Value="{DynamicResource ErrorBgLight}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Quality}" Value="GoodDistractor">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBgLight}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBgLight}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding EvaluationMessage}" FontSize="10.5" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Quality}" Value="MisleadingDistractor">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Error}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Quality}" Value="GoodDistractor">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <Border Grid.Row="2" Margin="0,8,0,0" Padding="11,7" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="Sağlıklı bir çeldirici şıkkı alt %27'lik grup tarafından üst %27'lik gruba göre daha yüksek oranda işaretlenmelidir. Üst grubun yoğun yöneldiği yanlış şıklar 'Ters Çeldirici' olarak raporlanır."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- 4. Alt Çubuk -->
                <Border Grid.Row="4" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding RunItemAnalysisCommand}" Style="{StaticResource OutlineButton}" Padding="14,7" FontSize="12" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Yeniden Hesapla" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Kapat" Command="{Binding CloseItemAnalysisCommand}" IsDefault="True"
                                Background="{DynamicResource Accent}" Foreground="White" Padding="24,7" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
