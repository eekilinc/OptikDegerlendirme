<UserControl x:Class="OptikFormApp.Views.Modals.GeneralConfigModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="540">

    <Grid Visibility="{Binding IsGeneralConfigOpen, Converter={StaticResource BoolToVis}}" 
          Background="{DynamicResource ModalBackdrop}">

        <Border MaxWidth="540"
                MaxHeight="640"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Margin="20,16"
                CornerRadius="14"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- Kurumsal Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource FluentIconFont}" FontSize="16" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Sınav ve Puanlama Parametreleri" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="Öğretim elemanı profili, net düşüm kuralları ve çıktı dizini" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseGeneralConfigCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Kapat (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Kaydırılabilir İçerik -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16">

                        <!-- 1. Öğretim Elemanı Profili & Kurum -->
                        <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="15,13" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource FluentIconFont}" FontSize="13.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Kurum ve Öğretim Elemanı Profili" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Okul / Kurum Başlığı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="12.5" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Öğretim Elemanı Adı / Unvanı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding InstructorName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="12.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bölüm / Program Adı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="12.5"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox IsChecked="{Binding ShowLetterGradeColumn}"
                                          Content="Öğrenci listesinde Harf Notu (AA–FF) sütununu göster (Tek sınavlarda kapalı önerilir)"
                                          Foreground="{DynamicResource TextMain}" FontSize="11.5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Puanlama Parametreleri -->
                        <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="15,13" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource FluentIconFont}" FontSize="13.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Net ve Puanlama Kuralları" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Yanlışın Doğruyu Götürme Kuralı (Düşüm)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox SelectedIndex="{Binding DeductionRuleIndex}" Margin="0,0,0,12" Padding="10,8" FontSize="12.5">
                                    <ComboBoxItem Content="Düşüm Yapılmasın (Net = Doğru Sayısı)"/>
                                    <ComboBoxItem Content="3 Yanlış 1 Doğruyu Götürür (0.33)"/>
                                    <ComboBoxItem Content="4 Yanlış 1 Doğruyu Götürür (0.25)"/>
                                </ComboBox>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Net Katsayısı (1 Net Puanı)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding NetCoefficient, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource Success}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Taban (Başlangıç) Puanı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding BaseScore, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource Accent}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Opsiyonel Harf Notu Modu (Yalnızca Harf Sütunu Açıksa Gösterilir) -->
                        <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="15,13" Margin="0,0,0,12"
                                Visibility="{Binding ShowLetterGradeColumn, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE7BE;" FontFamily="{StaticResource FluentIconFont}" FontSize="13.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Harf Notu Ölçeği (Çoklu Sınav / Dönem Sonu)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <ComboBox SelectedIndex="{Binding GradingModeIndex, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="12.5" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Bağıl Değerlendirme (YÖK Çan Eğrisi / T-Skor)"/>
                                    <ComboBoxItem Content="Mutlak Değerlendirme (Sabit Katalog Aralıkları)"/>
                                </ComboBox>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Bağıl Değerlendirme Alt Sınırı (HBN)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="Bu sınırın altındaki puanlar doğrudan FF olarak değerlendirilir" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding RelativeThreshold, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="13.5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Varsayılan Çıktı Klasörü -->
                        <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="15,13">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource FluentIconFont}" FontSize="13.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Varsayılan Rapor Çıktı Klasörü" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding DefaultExcelPath}" Padding="10,8" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    <Button Grid.Column="2" Command="{Binding SelectFolderCommand}" Style="{StaticResource OutlineButton}" Padding="14,8" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource FluentIconFont}" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Klasör Seç" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Alt Aksiyon Çubuğu -->
                <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid>
                        <TextBlock Text="Değişiklikler otomatik olarak kaydedilir." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        <Button Content="Kaydet ve Kapat" Command="{Binding CloseGeneralConfigCommand}" IsDefault="True" HorizontalAlignment="Right"
                                Background="{DynamicResource Accent}" Foreground="White" Padding="22,8" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
