<Window x:Class="OptikFormApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OptikFormApp.ViewModels"
        xmlns:views="clr-namespace:OptikFormApp.Views"
        xmlns:modals="clr-namespace:OptikFormApp.Views.Modals"
        Title="AĞLASUN MYO Optik Değerlendirme" Height="750" Width="1150" MinWidth="850" MinHeight="600"
        Icon="/Assets/app_logo.png"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}" FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="MainWindow_Drop"
        DragEnter="MainWindow_DragEnter"
        DragLeave="MainWindow_DragLeave">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <!-- Dosya kısayolları -->
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding LoadTxtCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveExamCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportExcelCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding ExportCsvCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding ExportPdfCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding ExportFullReportCommand}" />
        <!-- İşlem kısayolları -->
        <KeyBinding Key="F5" Command="{Binding EvaluateCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowShortcutsCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- APP SHELL -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Menu -->
                <RowDefinition Height="*"/>    <!-- Main View -->
            </Grid.RowDefinitions>

            <!-- MODERN TOP MENU -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Menu Background="Transparent" Padding="10,5">
                    <MenuItem Header="_Dosya">
                        <MenuItem Header="Optik Verisi Yükle (.txt)" Command="{Binding LoadTxtCommand}" InputGestureText="Ctrl+O"/>
                        <Separator/>
                        <MenuItem Header="Veri Alışverişi">
                            <MenuItem Header="JSON'dan Yükle..." Command="{Binding ImportJsonCommand}"/>
                            <MenuItem Header="JSON'a Aktar..." Command="{Binding ExportJsonCommand}"/>
                            <Separator/>
                            <MenuItem Header="Şablonu İçe Aktar..." Command="{Binding ImportTemplateCommand}"/>
                            <MenuItem Header="Şablonu Dışa Aktar..." Command="{Binding ExportTemplateCommand}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Çıkış" Command="{Binding ExitCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_Düzen">
                        <MenuItem Header="Geri Al" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="Yinele" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                    </MenuItem>
                    <MenuItem Header="_Sınav">
                        <MenuItem Header="Sınavı Veritabanına Kaydet" Command="{Binding SaveExamCommand}" InputGestureText="Ctrl+S"/>
                        <Separator/>
                        <MenuItem Header="Cevap Anahtarlarını Yönet" Command="{Binding OpenModalCommand}"/>
                        <MenuItem Header="🔄 Kitapçık Dönüştürücü (Eşleme Matrisi)" Command="{Binding OpenBookletMappingCommand}"/>
                        <MenuItem Header="Soru Ayarlarını Yönet (İptal/Çoklu)" Command="{Binding OpenQuestionSettingsCommand}"/>
                        <MenuItem Header="Öğrenim Çıktılarını (Konu) Yönet" Command="{Binding OpenLearningOutcomesCommand}"/>
                        <Separator/>
                        <MenuItem Header="🔍 Gelişmiş Filtreleme" Command="{Binding OpenAdvancedFilterCommand}"/>
                        <Separator/>
                        <MenuItem Header="Puanları Hesapla" Command="{Binding EvaluateCommand}" InputGestureText="F5"/>
                    </MenuItem>
                    <MenuItem Header="_Ders">
                        <MenuItem Header="Yeni Ders Ekle..." Command="{Binding ShowAddCourseCommand}"/>
                        <MenuItem Header="Seçili Dersi Sil" Command="{Binding DeleteCourseCommand}" CommandParameter="{Binding SelectedCourse}"/>
                    </MenuItem>
                    <MenuItem Header="_Raporlar">
                        <MenuItem Header="Excel Raporu Al (.xlsx)" Command="{Binding ExportExcelCommand}" InputGestureText="Ctrl+E"/>
                        <MenuItem Header="CSV Olarak Dışa Aktar (.csv)" Command="{Binding ExportCsvCommand}" InputGestureText="Ctrl+Shift+C"/>
                        <MenuItem Header="Not Listesi (No + Puan) (.csv)" Command="{Binding ExportGradeListCommand}"/>
                        <Separator/>
                        <MenuItem Header="Toplu PDF Karne Al (.pdf)" Command="{Binding ExportPdfCommand}" InputGestureText="Ctrl+P"/>
                        <MenuItem Header="📄 Tam Rapor PDF (Tüm Analizler)" Command="{Binding ExportFullReportCommand}" InputGestureText="Ctrl+Shift+R"/>
                        <Separator/>
                        <MenuItem Header="📊 Gelişmiş Soru Analizi" Command="{Binding OpenItemAnalysisCommand}"/>
                        <MenuItem Header="🔮 Başarı Tahmini" Command="{Binding OpenSuccessPredictionCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_Ayarlar">
                        <MenuItem Header="Arayüz Ayarları..." Command="{Binding OpenUISettingsCommand}"/>
                        <MenuItem Header="Genel Hesaplama Ayarları..." Command="{Binding OpenGeneralConfigCommand}"/>
                        <Separator/>
                        <MenuItem Header="Sınav Şablonlarını Yönet..." Command="{Binding OpenTemplateManagerCommand}"/>
                        <Separator/>
                        <MenuItem Header="📦 Yedekleme ve Geri Yükleme">
                            <MenuItem Header="Tam Yedek Oluştur (.zip)" Command="{Binding CreateFullBackupCommand}"/>
                            <MenuItem Header="Sadece Veritabanı Yedekle (.db)" Command="{Binding CreateDatabaseBackupCommand}"/>
                            <MenuItem Header="Ayarları Dışa Aktar (.json)" Command="{Binding ExportSettingsCommand}"/>
                            <Separator/>
                            <MenuItem Header="Tam Yedek Geri Yükle (.zip)" Command="{Binding RestoreFullBackupCommand}"/>
                            <MenuItem Header="Veritabanı Geri Yükle (.db)" Command="{Binding RestoreDatabaseCommand}"/>
                            <MenuItem Header="Ayarları İçe Aktar (.json)" Command="{Binding ImportSettingsCommand}"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Yardım">
                        <MenuItem Header="Klavye Kısayolları" Command="{Binding ShowShortcutsCommand}" InputGestureText="F1"/>
                        <Separator/>
                        <MenuItem Header="Uygulama Hakkında..." Command="{Binding OpenAboutCommand}"/>
                    </MenuItem>
                </Menu>
            </Border>

            <!-- SIDEBAR: COURSES & EXAMS -->
            <views:SidebarView Grid.Row="1" Grid.Column="0" />

            <!-- Main Content -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- MODERN WORKFLOW ACTION BAR -->
                <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#05FFFFFF" Offset="0"/>
                            <GradientStop Color="#053B82F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                       From="-30" To="0" Duration="0:0:0.6">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                       From="0" To="1" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                    </Border.Triggers>
                    <views:WorkflowView />
                </Border>

                <!-- EXECUTIVE KPI DASHBOARD (Shown when students loaded) -->
                <views:DashboardKpiView Grid.Row="1" Margin="0,0,0,15"
                                        Visibility="{Binding Students.Count, Converter={StaticResource DataToVisConverter}}"/>

                <!-- TAB CONTROL -->
                <Border Grid.Row="2" Style="{StaticResource GlassCard}" ClipToBounds="True">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.3" RadiusX="1" RadiusY="1">
                            <GradientStop Color="#08FFFFFF" Offset="0"/>
                            <GradientStop Color="#038B5CF6" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                       From="50" To="0" Duration="0:0:0.8" BeginTime="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                       From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                    </Border.Triggers>

                    <TabControl Background="Transparent" BorderThickness="0" Margin="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border Name="Border" Padding="20,12" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="{DynamicResource CardBg}">
                                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter Property="TextElement.Foreground" Value="#3B82F6"/>
                                                    <Setter Property="TextElement.FontWeight" Value="Bold"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="False">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMuted}"/>
                                                    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="TextElement.Foreground" Value="#3B82F6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        <!-- TAB 1: STUDENTS -->
                        <TabItem Header="Öğrenci İşlemleri">
                            <views:StudentListView />
                        </TabItem>

                        <!-- TAB 2: STATISTICS -->
                        <TabItem Header="Madde Analizi">
                            <views:StatisticsView />
                        </TabItem>

                        <!-- TAB 3: CHARTS -->
                        <TabItem Header="Grafiksel Analiz">
                            <views:PremiumChartsView />
                        </TabItem>

                        <!-- TAB 4: OUTCOMES -->
                        <TabItem Header="Kazanım Değerlendirmesi">
                            <views:OutcomesView />
                        </TabItem>

                        <!-- TAB 5: QUESTION DIFFICULTY -->
                        <TabItem Header="Zorluk Seviyesi Analizi">
                            <views:QuestionDifficultyView />
                        </TabItem>

                        <!-- TAB 6: STATISTICAL REPORTS -->
                        <TabItem Header="İstatistiksel Raporlar">
                            <views:StatisticsReportView />
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- STATUS PANEL & LOGS (BOTTOM) -->
                <Border Grid.Row="3" Margin="0,20,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                       From="30" To="0" Duration="0:0:0.6" BeginTime="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                       From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                    </Border.Triggers>
                    <views:StatusPanelView />
                </Border>
            </Grid>
        </Grid>

        <!-- TOAST NOTIFICATION HOST (Always on top) -->
        <views:ToastNotificationHost DataContext="{Binding Notifications}" 
                                     Panel.ZIndex="2000" 
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,80,20,0"/>

        <!-- PROGRESS MODAL OVERLAY -->
        <modals:ProgressModal Panel.ZIndex="1500" />

        <!-- BOOKLET SETTINGS MODAL OVERLAY -->
        <modals:BookletSettingsModal Panel.ZIndex="200" />

        <!-- DETAILED ANSWER KEY EDITOR MODAL OVERLAY -->
        <modals:DetailedAnswerKeyEditorModal Panel.ZIndex="205" />

        <!-- BULK ANSWER ENTRY MODAL OVERLAY -->
        <modals:BulkAnswerEntryModal Panel.ZIndex="206" />

        <!-- SHORTCUTS MODAL OVERLAY -->
        <modals:ShortcutsModal Panel.ZIndex="250" />

        <!-- SHORTCUT SETTINGS MODAL OVERLAY -->
        <modals:ShortcutSettingsModal Panel.ZIndex="260" />

        <!-- INTERFACE SETTINGS OVERLAY -->
        <modals:UISettingsModal Panel.ZIndex="300" />

        <!-- GENERAL CONFIG MODAL OVERLAY -->
        <modals:GeneralConfigModal Panel.ZIndex="500" />

        <!-- QUESTION SETTINGS MODAL OVERLAY -->
        <modals:QuestionSettingsModal Panel.ZIndex="400" />

        <!-- LEARNING OUTCOMES MODAL OVERLAY -->
        <modals:LearningOutcomesModal Panel.ZIndex="500" />

        <!-- ABOUT OVERLAY -->
        <modals:AboutModal Panel.ZIndex="600" />

        <!-- ADD COURSE MODAL OVERLAY -->
        <modals:AddCourseModal Panel.ZIndex="600" />

        <!-- SAVE EXAM MODAL OVERLAY -->
        <modals:SaveExamModal Panel.ZIndex="602" />

        <!-- RENAME MODAL OVERLAY -->
        <modals:RenameModal Panel.ZIndex="605" />

        <!-- CONFIRM MODAL OVERLAY -->
        <modals:ConfirmModal Panel.ZIndex="606" />

        <!-- TEMPLATE MANAGER MODAL OVERLAY -->
        <modals:TemplateManagerModal Panel.ZIndex="610" />

        <!-- ITEM ANALYSIS MODAL OVERLAY -->
        <modals:ItemAnalysisModal Panel.ZIndex="620" 
                                  Visibility="{Binding IsItemAnalysisOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- ADVANCED FILTER MODAL OVERLAY -->
        <modals:AdvancedFilterModal Panel.ZIndex="630" 
                                     Visibility="{Binding IsAdvancedFilterOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- SUCCESS PREDICTION MODAL OVERLAY -->
        <modals:SuccessPredictionModal Panel.ZIndex="640" 
                                        Visibility="{Binding IsSuccessPredictionOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- STUDENT DETAIL MODAL OVERLAY -->
        <modals:StudentDetailModal Panel.ZIndex="645" 
                                   Visibility="{Binding IsStudentDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- BOOKLET MAPPING MODAL OVERLAY -->
        <modals:BookletMappingModal Panel.ZIndex="648" 
                                    Visibility="{Binding IsBookletMappingOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- VALIDATION DETAILS MODAL OVERLAY -->
        <modals:ValidationDetailsModal Panel.ZIndex="650" 
                                       Visibility="{Binding IsValidationDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- BUSY LOADING OVERLAY -->
        <modals:BusyOverlay Panel.ZIndex="1000" />
    </Grid>
</Window>
