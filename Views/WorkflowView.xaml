<UserControl x:Class="OptikFormApp.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="1200">
    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="16,12" Margin="0,0,0,16">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.04" BlurRadius="16" ShadowDepth="2"/>
        </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Logo ve Sistem Başlığı -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <Border Width="42" Height="42" CornerRadius="12" Background="#EFF6FF" Margin="0,0,12,0" Padding="6">
                    <Image Source="/Assets/app_logo.png" Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AĞLASUN MYO" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource TextMain}"/>
                        <Border Background="#DBEAFE" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.4 PRO" FontSize="9" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Optik Değerlendirme &amp; İstatistik Sistemi" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Sağ Buton Grupları (İşlemler, Ayarlar, Dışa Aktar) -->
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                
                <!-- 1. Temel İşlem Pipeline -->
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="8,5" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Yükle -->
                        <Button Command="{Binding LoadTxtCommand}" Style="{StaticResource PipelineButton}" 
                                Background="#16A34A" BorderBrush="#15803D" Foreground="White" Padding="12,7" Margin="0,0,6,0"
                                ToolTip="Optik txt veya dat dosyasını içe aktar (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Veri Yükle" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Kaydet -->
                        <Button Command="{Binding OpenSaveExamModalCommand}" IsEnabled="{Binding Students.Count}" 
                                Padding="12,7" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PipelineButton}">
                                    <Setter Property="Background" Value="#22C55E"/>
                                    <Setter Property="BorderBrush" Value="#16A34A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnsavedData}" Value="True">
                                            <Setter Property="Background" Value="#DC2626"/>
                                            <Setter Property="BorderBrush" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✓"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnsavedData}" Value="True">
                                                    <Setter Property="Text" Value="💾"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="12" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Kaydedildi"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnsavedData}" Value="True">
                                                    <Setter Property="Text" Value="Sınavı Kaydet"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        
                        <!-- Puanla / Hesapla -->
                        <Button Command="{Binding EvaluateCommand}" Style="{StaticResource PipelineButton}" 
                                Background="#7C3AED" BorderBrush="#6D28D9" Foreground="White" Padding="14,7"
                                ToolTip="Cevap anahtarına göre puanları ve istatistikleri hesapla (F5)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Hesapla (F5)" FontSize="12" FontWeight="ExtraBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- 2. Sınav Ayarları Grubu -->
                <Border Background="{DynamicResource AltRowBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="8,5" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding OpenModalCommand}" Style="{StaticResource OutlineButton}" Padding="10,7" Margin="0,0,6,0"
                                ToolTip="Kitapçık cevap anahtarlarını düzenle">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="Cevap Anahtarı" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenGeneralConfigCommand}" Style="{StaticResource OutlineButton}" Padding="10,7"
                                ToolTip="Yanlış götürme katsayısı, baraj puanı ve BDS ayarları">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="Ayarlar" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- 3. Dışa Aktarma Grubu -->
                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="8,5" 
                        Visibility="{Binding Students.Count, Converter={StaticResource DataToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource PipelineButton}" 
                                Background="#D97706" BorderBrush="#B45309" Foreground="White" Padding="10,7" Margin="0,0,6,0"
                                ToolTip="Tüm detayları Excel (.xlsx) olarak aktar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="Excel" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource PipelineButton}" 
                                Background="#C2410C" BorderBrush="#9A3412" Foreground="White" Padding="10,7" Margin="0,0,6,0"
                                ToolTip="Not listesini CSV olarak dışa aktar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="CSV" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportFullReportCommand}" Style="{StaticResource PipelineButton}" 
                                Background="#BE185D" BorderBrush="#9D174D" Foreground="White" Padding="11,7"
                                ToolTip="Kapsamlı karne ve analiz raporunu PDF olarak yazdır">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📑" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="PDF Rapor" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>

