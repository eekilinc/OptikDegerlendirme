<UserControl x:Class="OptikFormApp.Views.Modals.DetailedAnswerKeyEditorModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="780">

    <Grid Visibility="{Binding IsDetailedAnswerKeyEditorOpen, Converter={StaticResource BoolToVis}}" 
          Background="{DynamicResource ModalBackdrop}">

        <Border MaxWidth="780"
                MaxHeight="640"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                CornerRadius="14"
                Margin="20,16"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- 1. Kurumsal Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource FluentIconFont}" FontSize="15.5" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Detaylı Cevap Anahtarı Editörü" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,8,0"/>
                                <Border Background="{DynamicResource AccentBgLight}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedAnswerKeyForEdit.BookletName, StringFormat='Kitapçık {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="Her sorunun doğru şıkkını tek tek veya toplu metin girişiyle düzenleyin" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding CloseDetailedAnswerKeyEditorCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Kapat (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. İşlem Araç Çubuğu -->
                <Border Grid.Row="2" Padding="18,10" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding AddQuestionToAnswerKeyCommand}" Style="{StaticResource PipelineButton}" Background="{DynamicResource Success}" BorderBrush="{DynamicResource Success}" Foreground="White" Padding="11,6" Margin="0,2,6,2" FontSize="11.5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource FluentIconFont}" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Soru Ekle" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding RemoveLastQuestionFromAnswerKeyCommand}" Style="{StaticResource OutlineButton}" BorderBrush="{DynamicResource Error}" Foreground="{DynamicResource Error}" Padding="11,6" Margin="0,2,10,2" FontSize="11.5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FluentIconFont}" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Son Soruyu Sil" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenBulkAnswerEntryCommand}" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,2,6,2" FontSize="11.5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource FluentIconFont}" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Toplu Metin Girişi" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AnalyzeAnswerKeyCommand}" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,2,0,2" FontSize="11.5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource FluentIconFont}" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Şık Dağılım Analizi" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border Grid.Column="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Toplam Soru: " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedAnswerKeyForEdit.AnswerDetails.Count}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Soru Kutuları -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14">
                    <ItemsControl ItemsSource="{Binding SelectedAnswerKeyForEdit.AnswerDetails}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="6" Margin="4" BorderThickness="1" BorderBrush="{DynamicResource Border}" Background="{DynamicResource HeaderBg}" Width="80" Height="74">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="Soru " FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding QuestionNumber}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="7">
                                            <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" CaretBrush="{DynamicResource Accent}"
                                                     MaxLength="1" TextAlignment="Center" VerticalContentAlignment="Center" Padding="0"
                                                     Background="Transparent" BorderThickness="0" CharacterCasing="Upper"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 4. Alt Çubuk -->
                <Border Grid.Row="4" Padding="20,12" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="Kutulara doğrudan A, B, C, D, E yazabilirsiniz. Kaydettiğinizde puanlar güncellenir." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <Button Content="Değişiklikleri Kaydet ve Puanla" Command="{Binding CloseDetailedAnswerKeyEditorCommand}" IsDefault="True"
                                HorizontalAlignment="Right" Background="{DynamicResource Accent}" Foreground="White" Padding="20,8" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
