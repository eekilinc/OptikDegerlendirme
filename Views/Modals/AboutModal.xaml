<UserControl x:Class="OptikFormApp.Views.Modals.AboutModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="430" d:DesignWidth="500">

    <Grid Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVis}}" 
          Background="{DynamicResource ModalBackdrop}">

        <!-- Kurumsal Tek Ekran Künye Penceresi -->
        <Border MaxWidth="500"
                MaxHeight="520"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                CornerRadius="14"
                Margin="20,16"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Üst Kurumsal Vurgu Çizgisi -->
                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- 1. Kurumsal Başlık -->
                <Border Grid.Row="1"
                        Background="{DynamicResource HeaderBg}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,0,0,1"
                        Padding="22,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Kurum / Uygulama Logosu -->
                        <Border Grid.Column="0"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                Margin="0,0,14,0"
                                Padding="6">
                            <Image Source="pack://application:,,,/OptikFormApp;component/Assets/app_logo.png" Stretch="Uniform"/>
                        </Border>

                        <!-- Başlık ve Sürüm Bilgisi -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="BURDUR MEHMET AKİF ERSOY ÜNİVERSİTESİ"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Optik Değerlendirme ve Sınav Analiz Sistemi"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMain}"
                                       Margin="0,2,0,5"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource AccentBgLight}" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="{Binding CurrentVersion, Mode=OneWay, StringFormat='Sürüm {0}'}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}"/>
                                </Border>
                                <TextBlock Text="•  Ağlasun Meslek Yüksekokulu"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Kapat Butonu -->
                        <Button Grid.Column="2"
                                Command="{Binding CloseAboutCommand}"
                                IsCancel="True"
                                VerticalAlignment="Top"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Kapat (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Sade Kurumsal Tanım ve Resmi Künye Tablosu -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,16,22,16">
                        <TextBlock Text="Optik okuyucu çıktılarını (.txt / .dat) işleyerek çoklu kitapçık sınav değerlendirmesi, psikometrik madde analizi, YÖKAK uyumlu öğrenim çıktısı takibi ve resmi akademik raporlama süreçlerini yürüten kurumsal masaüstü yazılımıdır."
                                   FontSize="12"
                                   LineHeight="18.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,0,14"/>

                        <!-- Kurumsal Künye Kartı -->
                        <Border Background="{DynamicResource HeaderBg}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,4">
                            <StackPanel>
                                <!-- Satır 1: Birim -->
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Kurum / Birim" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="MAKÜ — Ağlasun Meslek Yüksekokulu" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Border}"/>

                                <!-- Satır 2: Geliştirici -->
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Geliştirici" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="Öğr. Gör. Ekrem KILINÇ" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Border}"/>

                                <!-- Satır 3: İletişim -->
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Kurumsal İletişim" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="ekilinc@mehmetakif.edu.tr" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Accent}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Border}"/>

                                <!-- Satır 4: Altyapı & Veri Güvenliği -->
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Altyapı ve Veri" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text=".NET 9.0 WPF • Yerel SQLite (%100 Çevrimdışı)" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Kurumsal Alt Bilgi (Footer) -->
                <Border Grid.Row="3"
                        Padding="22,11"
                        Background="{DynamicResource HeaderBg}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="© 2026 Ağlasun Meslek Yüksekokulu. Kurum içi akademik kullanım içindir."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0"/>

                        <Button Content="Kapat"
                                Command="{Binding CloseAboutCommand}"
                                IsDefault="True"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource Accent}"
                                Foreground="White"
                                Padding="22,7"
                                FontSize="12"
                                FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
