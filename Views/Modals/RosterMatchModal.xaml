<UserControl x:Class="OptikFormApp.Views.Modals.RosterMatchModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="820">

    <Grid Visibility="{Binding IsRosterMatchOpen, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource ModalBackdrop}">
        <Border MaxWidth="840" MaxHeight="650" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                CornerRadius="14" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="20,16" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource FluentIconFont}" FontSize="15.5" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Sınıf Listesi Eşleştirme ve Yoklama Analizi" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="OBS sınıf listesiyle karşılaştırarak sınava girmeyenleri (G) ve hatalı numara kodlayanları tespit edin" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseRosterMatchCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Dosya Seçim ve Özet Bar -->
                <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding RosterFileName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding RosterMatchSummary}" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding LoadRosterFileCommand}" Style="{StaticResource PipelineButton}"
                                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="White" Padding="14,7" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource FluentIconFont}" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sınıf Listesi Yükle (.xlsx / .csv)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Sonuç Sekmeleri -->
                <TabControl Grid.Row="3" Margin="20,10" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Padding="13,8" Margin="0,0,6,0" CornerRadius="8,8,0,0" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Cursor="Hand">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HeaderBg}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent}"/>
                                                <Setter Property="TextElement.FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMuted}"/>
                                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Yanlış Numara Şüphesi (Düzelt)">
                        <DataGrid ItemsSource="{Binding SuspectedMismatches}" AutoGenerateColumns="False" IsReadOnly="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Margin="0,8,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="OPTİK NO" Binding="{Binding OpticalId}" Width="105"/>
                                <DataGridTextColumn Header="OPTİK İSİM" Binding="{Binding OpticalName}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="ÖNERİLEN NO" Binding="{Binding SuggestedRosterId}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="LİSTEDEKİ İSİM" Binding="{Binding SuggestedRosterName}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="BENZERLİK" Binding="{Binding SimilarityPercent, StringFormat='{}%{0:F0}'}" Width="80"/>
                                <DataGridTemplateColumn Header="İŞLEM" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Düzelt"
                                                    Command="{Binding DataContext.ApplySuspectedFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource Success}" Foreground="White" Padding="10,4" FontSize="11" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Sınava Girmeyenler (G)">
                        <DataGrid ItemsSource="{Binding AbsentStudents}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,8,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ÖĞRENCİ NO" Binding="{Binding StudentId}" Width="140"/>
                                <DataGridTextColumn Header="AD SOYAD" Binding="{Binding FullName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Listede Olmayanlar (Misafir)">
                        <DataGrid ItemsSource="{Binding UnlistedOpticalStudents}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,8,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="OPTİK NO" Binding="{Binding StudentId}" Width="130"/>
                                <DataGridTextColumn Header="AD SOYAD" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="PUAN" Binding="{Binding Score, StringFormat='{}{0:F2}'}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <!-- Alt Çubuk -->
                <Border Grid.Row="4" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid>
                        <Button Command="{Binding ExportAbsentStudentsCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Padding="13,7" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sınava Girmeyenleri İndir (.csv)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CloseRosterMatchCommand}" IsDefault="True" HorizontalAlignment="Right"
                                Background="{DynamicResource Accent}" Foreground="White" Padding="22,7" FontSize="12" FontWeight="SemiBold" Content="Kapat"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
