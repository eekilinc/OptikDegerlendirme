<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme defaults (design-time + runtime fallback) -->
    <SolidColorBrush x:Key="AppBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMain" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextMuted" Color="#475569"/>
    <SolidColorBrush x:Key="Border" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="AltRowBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HoverBg" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="ModalBackdrop" Color="#800F172A"/>
    <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2563EB"/>
    <SolidColorBrush x:Key="Success" Color="#10B981"/>
    <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Error" Color="#EF4444"/>
    <SolidColorBrush x:Key="GlassCardBgColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GlassCardBorderColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShadowColor" Color="#000000"/>
</ResourceDictionary>