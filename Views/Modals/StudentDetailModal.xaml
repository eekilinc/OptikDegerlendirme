<UserControl x:Class="OptikFormApp.Views.Modals.StudentDetailModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="700">
    <Grid Visibility="{Binding IsStudentDetailOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ModalBackdrop}">
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="16" MaxWidth="700" MaxHeight="600" Margin="20,16"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.2" BlurRadius="35" ShadowDepth="8"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource HoverBg}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource FluentIconFont}" FontSize="15" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Öğrenci Detayları ve Optik Cevaplar" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" IsCancel="True" Command="{Binding CloseStudentDetailCommand}" 
                            Style="{StaticResource OutlineButton}" Width="32" Height="32" Padding="0"/>
                </Grid>

                <!-- Student Info Edit Section -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Öğrenci Numarası" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedStudentDetail.StudentId, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,7" FontSize="13.5" x:Name="StudentIdTextBox"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,0">
                            <TextBlock Text="Ad Soyad" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedStudentDetail.FullName, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,7" FontSize="13.5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="Kitapçık" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,7" MinWidth="56" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SelectedStudentDetail.BookletType}" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextMuted}">
                                <Run Text="Doğru: "/>
                                <Run Text="{Binding SelectedStudentDetail.CorrectCount}" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                                <Run Text="  |  Yanlış: "/>
                                <Run Text="{Binding SelectedStudentDetail.IncorrectCount}" FontWeight="Bold" Foreground="{DynamicResource Error}"/>
                                <Run Text="  |  Boş: "/>
                                <Run Text="{Binding SelectedStudentDetail.EmptyCount}" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <Run Text="  |  Net: "/>
                                <Run Text="{Binding SelectedStudentDetail.NetCount, StringFormat={}{0:N2}}" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                <Run Text="  |  Puan: "/>
                                <Run Text="{Binding SelectedStudentDetail.Score, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Accent}"/>
                            </TextBlock>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Answers Section -->
                <TextBlock Grid.Row="2" Text="Soru Bazlı İşaretlenen Cevaplar" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,8"/>
                
                <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedStudentDetail.ColoredAnswers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="42" Height="42" Margin="3" CornerRadius="6" 
                                            Background="{Binding State, Converter={StaticResource AnswerStateToBgConverter}}">
                                        <Grid>
                                            <TextBlock Text="{Binding QuestionNumber}" FontSize="9" 
                                                       Foreground="{DynamicResource TextMuted}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Character}" FontSize="15" FontWeight="Bold" 
                                                       Foreground="{Binding State, Converter={StaticResource AnswerStateConverter}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Buttons -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Vazgeç (Esc)" Command="{Binding CloseStudentDetailCommand}" 
                            Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="Değişiklikleri Kaydet" IsDefault="True" Command="{Binding SaveStudentDetailCommand}" 
                            Background="{DynamicResource Accent}" Foreground="White" Padding="14,8" Margin="6,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
