<UserControl x:Class="OptikFormApp.Views.Modals.AdvancedFilterModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignHeight="540" d:DesignWidth="480">

    <Grid Visibility="{Binding IsAdvancedFilterOpen, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource ModalBackdrop}">

        <Border MaxWidth="480"
                MaxHeight="580"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Margin="20,16"
                CornerRadius="14"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.22" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Accent}"/>

                <!-- Başlık -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE71C;" FontFamily="{StaticResource FluentIconFont}" FontSize="15" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Gelişmiş Öğrenci Filtreleme ve Sıralama" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Text="Puan aralığı, doğru/yanlış sınırı ve kitapçık kriterleri" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseAdvancedFilterCommand}" IsCancel="True" VerticalAlignment="Top" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Kaydırılabilir Filtre Formu -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16">

                        <!-- Puan Aralığı -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimum Puan" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding MinScoreFilter, TargetNullValue=''}" Padding="10,8" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Bottom" Margin="10,0,10,8" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Maksimum Puan" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding MaxScoreFilter, TargetNullValue=''}" Padding="10,8" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- Kitapçık -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Kitapçık Türü" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableBookletTypes}" SelectedItem="{Binding SelectedBookletFilter}" Padding="10,8" FontSize="13"/>
                        </StackPanel>

                        <!-- Doğru / Yanlış -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimum Doğru Sayısı" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding MinCorrectFilter, TargetNullValue=''}" Padding="10,8" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Maksimum Yanlış Sayısı" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding MaxWrongFilter, TargetNullValue=''}" Padding="10,8" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sıralama -->
                        <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource FluentIconFont}" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Liste Sıralama Ölçütü" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" SelectedItem="{Binding SelectedSortColumn}" Padding="10,8" FontSize="12.5">
                                        <ComboBox.ItemsSource>
                                            <x:Array Type="{x:Type sys:String}">
                                                <sys:String>Puan</sys:String>
                                                <sys:String>Ad Soyad</sys:String>
                                                <sys:String>Öğrenci No</sys:String>
                                                <sys:String>Doğru Sayısı</sys:String>
                                                <sys:String>Yanlış Sayısı</sys:String>
                                                <sys:String>Net Sayısı</sys:String>
                                                <sys:String>Sıralama</sys:String>
                                            </x:Array>
                                        </ComboBox.ItemsSource>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="{Binding IsSortDescending, Converter={StaticResource SortDirectionConverter}}"
                                            Command="{Binding ToggleSortDirectionCommand}" Style="{StaticResource OutlineButton}" Padding="12,8" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Aktif Filtre Özeti -->
                        <Border Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12,8"
                                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ActiveFiltersSummary}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Alt Çubuk -->
                <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid>
                        <Button Content="Filtreleri Temizle" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Left"
                                Style="{StaticResource OutlineButton}" BorderBrush="{DynamicResource Error}" Foreground="{DynamicResource Error}" Padding="14,7" FontSize="12"/>
                        <Button Content="Uygula ve Kapat" Command="{Binding CloseAdvancedFilterCommand}" IsDefault="True" HorizontalAlignment="Right"
                                Background="{DynamicResource Accent}" Foreground="White" Padding="20,7" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
