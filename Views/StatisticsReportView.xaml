<UserControl x:Class="OptikFormApp.Views.StatisticsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1050">

    <UserControl.Resources>
        <Style x:Key="AcademicKpiCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.04" BlurRadius="14" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricRowCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="AcademicSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.04" BlurRadius="12" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. AKADEMİK RAPOR ÜST BAŞLIK BANDI -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColorValue}" Opacity="0.04" BlurRadius="14" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentPurpleColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentVioletColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🎓" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Akademik Sınav Analiz &amp; Değerlendirme Raporu" 
                                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            <Border Background="{DynamicResource AccentBgLight}" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ClassStats.TotalStudents, StringFormat='{}{0} Öğrenci'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Derece listeleri, kitapçık adaleti, soru özeti, psikometrik güvenilirlik (KR-20) ve pedagojik yorumlar" 
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CopyReportCommand}" Style="{StaticResource OutlineButton}"
                            Padding="12,8" Margin="0,0,8,0" FontSize="12"
                            ToolTip="Tüm akademik istatistik raporunu metin olarak panoya kopyala">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,6,0"/>
                            <TextBlock Text="Metni Kopyala"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportFullReportCommand}" Style="{StaticResource PipelineButton}"
                            Background="{DynamicResource AccentPurple}" BorderBrush="{DynamicResource AccentPurple}" Foreground="White"
                            Padding="14,8" FontSize="12" FontWeight="Bold"
                            ToolTip="Kapak sayfalı kapsamlı akademik PDF raporu oluştur">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📑" Margin="0,0,6,0"/>
                            <TextBlock Text="Akademik PDF Rapor"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ÜST AKADEMİK KPI ŞERİDİ (5 TEMEL METRİK) -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,0,0,14">
            <!-- 1. Ortalama & Net -->
            <Border Style="{StaticResource AcademicKpiCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ARİTMETİK ORTALAMA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Row="1" Text="{Binding ClassStats.AverageScore, StringFormat='{}{0:F2}'}" 
                               FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource AccentHover}" Margin="0,3,0,2"/>
                    <TextBlock Grid.Row="2" Text="{Binding ClassStats.AverageNet, StringFormat='{}Ort. Net: {0:F2}'}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                </Grid>
            </Border>

            <!-- 2. Medyan & Ranj -->
            <Border Style="{StaticResource AcademicKpiCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="MEDYAN (ORTANCA)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Row="1" Text="{Binding ClassStats.MedianScore, StringFormat='{}{0:F2}'}" 
                               FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource AccentViolet}" Margin="0,3,0,2"/>
                    <TextBlock Grid.Row="2" Text="{Binding ClassStats.MinMaxSummary}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                </Grid>
            </Border>

            <!-- 3. Standart Sapma & SeM -->
            <Border Style="{StaticResource AcademicKpiCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="STANDART SAPMA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Row="1" Text="{Binding ClassStats.StandardDeviation, StringFormat='{}{0:F2}'}" 
                               FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource AccentOrange}" Margin="0,3,0,2"/>
                    <TextBlock Grid.Row="2" Text="{Binding ClassStats.StandardErrorOfMeasurement, StringFormat='{}SeM: ±{0:F2} Puan'}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                </Grid>
            </Border>

            <!-- 4. Başarı Oranı -->
            <Border Style="{StaticResource AcademicKpiCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="GENEL BAŞARI ORANI" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Row="1" Text="{Binding ClassStats.SuccessRate, StringFormat='{}%{0:F1}'}" 
                               FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource Success}" Margin="0,3,0,2"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding ClassStats.PassedCount, StringFormat='{}{0} Geçti'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Success}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ClassStats.FailedCount, StringFormat='{}{0} Kaldı'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Error}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Güvenilirlik KR-20 -->
            <Border Style="{StaticResource AcademicKpiCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="GÜVENİLİRLİK (KR-20)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Row="1" Text="{Binding ReliabilityStats.KR20, StringFormat='{}{0:F3}'}" 
                               FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}" Margin="0,3,0,2"/>
                    <TextBlock Grid.Row="2" Text="{Binding ClassStats.ReliabilityInterpretation}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- 3. DETAYLI AKADEMİK ANALİZ SEKMELERİ -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Padding="16,9" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="{DynamicResource CardBg}" Margin="0,0,4,0" CornerRadius="8,8,0,0" Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentPurple}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentPurple}"/>
                                        <Setter Property="TextElement.FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMuted}"/>
                                        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: DERECE & KRİTİK GRUPLAR (EN YÜKSEK / EN DÜŞÜK ALANLAR) -->
            <TabItem Header="🏆 Derece &amp; Kritik Gruplar">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,0,0">
                    <StackPanel>
                        <!-- En Yüksek & En Düşük Hızlı Özet + D/Y/B Ortalamaları -->
                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <Border Background="{DynamicResource SuccessBgLight}" BorderBrush="{DynamicResource Success}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="🥇 EN YÜKSEK PUAN ALAN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                                    <TextBlock Text="{Binding ClassStats.MaxScore, StringFormat='{}{0:F2} Puan'}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource Success}" Margin="0,2"/>
                                    <TextBlock Text="{Binding ClassStats.TopScoreStudentNames}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ErrorBgLight}" BorderBrush="{DynamicResource Error}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="⚠️ EN DÜŞÜK PUAN ALAN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Error}"/>
                                    <TextBlock Text="{Binding ClassStats.MinScore, StringFormat='{}{0:F2} Puan'}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource Error}" Margin="0,2"/>
                                    <TextBlock Text="{Binding ClassStats.LowestScoreStudentNames}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="📝 SINIF CEVAP ORTALAMALARI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                        <TextBlock Text="{Binding ClassStats.AverageCorrect, StringFormat='{}{0:F1} D'}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Success}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding ClassStats.AverageIncorrect, StringFormat='{}{0:F1} Y'}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Error}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding ClassStats.AverageEmpty, StringFormat='{}{0:F1} B'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ClassStats.AverageNet, StringFormat='{}Ortalama Net: {0:F2}'}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- EN YÜKSEK PUAN ALANLAR TABLOSU (İLK 5) -->
                        <Border Style="{StaticResource AcademicSectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Success}" Margin="0,0,8,0"/>
                                        <TextBlock Text="En Yüksek Puan Alan Öğrenciler (Onur Listesi — İlk 5)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource SuccessBgLight}" CornerRadius="6" Padding="8,2">
                                        <TextBlock Text="Üst Başarı Grubu" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                                    </Border>
                                </Grid>

                                <DataGrid ItemsSource="{Binding TopStudents}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="34">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Sıra" Binding="{Binding Rank, StringFormat='#{0}'}" Width="55"/>
                                        <DataGridTextColumn Header="Öğrenci No" Binding="{Binding StudentId}" Width="110"/>
                                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="Kitapçık" Binding="{Binding BookletType}" Width="75"/>
                                        <DataGridTextColumn Header="D / Y / B" Binding="{Binding CorrectWrongEmptyText}" Width="115"/>
                                        <DataGridTextColumn Header="Net" Binding="{Binding NetCount, StringFormat='{}{0:F2}'}" Width="65"/>
                                        <DataGridTextColumn Header="Puan" Binding="{Binding Score, StringFormat='{}{0:F2}'}" Width="85">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- EN DÜŞÜK PUAN ALANLAR TABLOSU (SON 5) -->
                        <Border Style="{StaticResource AcademicSectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Error}" Margin="0,0,8,0"/>
                                        <TextBlock Text="En Düşük Puan Alan Öğrenciler (Destek Gereken Grup — Son 5)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource ErrorBgLight}" CornerRadius="6" Padding="8,2">
                                        <TextBlock Text="Akademik Takip Önerilir" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Error}"/>
                                    </Border>
                                </Grid>

                                <DataGrid ItemsSource="{Binding LowestStudents}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="34">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Sıra" Binding="{Binding Rank, StringFormat='#{0}'}" Width="55"/>
                                        <DataGridTextColumn Header="Öğrenci No" Binding="{Binding StudentId}" Width="110"/>
                                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="Kitapçık" Binding="{Binding BookletType}" Width="75"/>
                                        <DataGridTextColumn Header="D / Y / B" Binding="{Binding CorrectWrongEmptyText}" Width="115"/>
                                        <DataGridTextColumn Header="Net" Binding="{Binding NetCount, StringFormat='{}{0:F2}'}" Width="65"/>
                                        <DataGridTextColumn Header="Puan" Binding="{Binding Score, StringFormat='{}{0:F2}'}" Width="85">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Error}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: KİTAPÇIK ADALETİ & SORU ÖZETİ -->
            <TabItem Header="📘 Kitapçık Adaleti &amp; Soru Özeti">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,0,0">
                    <StackPanel>
                        <!-- Kitapçık Bazlı Karşılaştırma (Tam Genişlik) -->
                        <Border Style="{StaticResource AcademicSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Kitapçık Bazlı Performans &amp; Adalet Analizi" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                <TextBlock Text="Farklı kitapçık türleri arasında anlamlı puan farkı olup olmadığını denetler" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,10"/>
                                <DataGrid ItemsSource="{Binding BookletComparison}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="34">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kitapçık" Binding="{Binding BookletName}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentViolet}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Öğrenci (n)" Binding="{Binding StudentCount}" Width="90"/>
                                        <DataGridTextColumn Header="Ortalama" Binding="{Binding AverageScore, StringFormat='{}{0:F2}'}" Width="95"/>
                                        <DataGridTextColumn Header="Medyan" Binding="{Binding MedianScore, StringFormat='{}{0:F1}'}" Width="85"/>
                                        <DataGridTextColumn Header="Std. Sapma" Binding="{Binding StandardDeviation, StringFormat='{}{0:F2}'}" Width="95"/>
                                        <DataGridTextColumn Header="En Düşük" Binding="{Binding MinScore, StringFormat='{}{0:F1}'}" Width="85"/>
                                        <DataGridTextColumn Header="En Yüksek" Binding="{Binding MaxScore, StringFormat='{}{0:F1}'}" Width="85"/>
                                        <DataGridTextColumn Header="Başarı %" Binding="{Binding PassRate, StringFormat='{}%{0:F1}'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- En Zor 5 & En Kolay 5 Soru Özeti -->
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource AcademicSectionCard}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="🔥 En Zor 5 Soru (En Düşük Doğru Oranı)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Error}" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding HardestQuestions}" AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="32">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Soru" Binding="{Binding QuestionNumber, StringFormat='Soru {0}'}" Width="70"/>
                                            <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat='{}%{0:F1}'}" Width="75"/>
                                            <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectAnswers}" Width="55"/>
                                            <DataGridTextColumn Header="Toplam" Binding="{Binding TotalAnswers}" Width="55"/>
                                            <DataGridTextColumn Header="Düzey" Binding="{Binding DifficultyLevel}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AcademicSectionCard}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="✨ En Kolay 5 Soru (En Yüksek Doğru Oranı)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Success}" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding EasiestQuestions}" AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="32">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Soru" Binding="{Binding QuestionNumber, StringFormat='Soru {0}'}" Width="70"/>
                                            <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat='{}%{0:F1}'}" Width="75"/>
                                            <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectAnswers}" Width="55"/>
                                            <DataGridTextColumn Header="Toplam" Binding="{Binding TotalAnswers}" Width="55"/>
                                            <DataGridTextColumn Header="Düzey" Binding="{Binding DifficultyLevel}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: MERKEZİ EĞİLİM VE YAYILMA ÖLÇÜLERİ -->
            <TabItem Header="📐 Merkezi Eğilim &amp; Yayılma">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Sınıfın Merkezi Eğilim ve Dağılım Parametreleri" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="2,0,0,12"/>
                        
                        <UniformGrid Columns="2">
                            <!-- Aritmetik Ortalama -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="Aritmetik Ortalama (Mean)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding ClassStats.AverageScore, StringFormat='{}{0:F2}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentHover}"/>
                                    <TextBlock Text="Sınıfın tüm puanlarının toplamının öğrenci sayısına bölümü" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Medyan -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="Medyan (Ortanca Değer)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding ClassStats.MedianScore, StringFormat='{}{0:F2}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}"/>
                                    <TextBlock Text="Sıralı listede sınıfı tam ortadan ikiye bölen puan (%50 dilimi)" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Mod (Tepe Değer) -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="Mod (Tepe Değer)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding ClassStats.ModeScoreText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                                    <TextBlock Text="Sınavda en çok tekrar eden / en fazla alınan puan" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Ranj (Puan Açıklığı) -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="Ranj (Puan Açıklığı / Range)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding ClassStats.Range, StringFormat='{}{0:F1} Puan'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentOrange}"/>
                                    <TextBlock Text="{Binding ClassStats.MinMaxSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Standart Sapma ve Varyans -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="Standart Sapma &amp; Varyans" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ClassStats.StandardDeviation, StringFormat='{}S: {0:F2}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Error}" Margin="0,0,15,0"/>
                                        <TextBlock Text="{Binding ClassStats.Variance, StringFormat='{}S²: {0:F2}'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Puanların ortalamadan ne kadar uzaklaştığının karesel ölçüsü" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Çeyrekler Açıklığı (IQR) & Varyasyon -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="Bağıl Değişkenlik (V) &amp; Çeyrekler Açıklığı (IQR)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,3">
                                        <TextBlock Text="{Binding ClassStats.VariationCoefficient, StringFormat='{}%{0:F1}'}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding ClassStats.InterquartileRange, StringFormat='{}IQR: {0:F1}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border Background="{DynamicResource AccentBgLight}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClassStats.HomogeneityInterpretation}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Grup yapısı: V &lt; 20 homojen, V &gt; 25 heterojen sınıf" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: DAĞILIM, YÜZDELİKLER & GÜVENİLİRLİK -->
            <TabItem Header="📊 Dağılım, Yüzdelikler &amp; Güvenilirlik">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,0,0">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <!-- Çarpıklık Katsayısı -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="Çarpıklık Katsayısı (Skewness)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding ClassStats.Skewness, StringFormat='{}{0:F2}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentHover}"/>
                                    <Border Background="{DynamicResource AccentBgLight}" CornerRadius="4" Padding="6,3" Margin="0,4,0,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ClassStats.SkewnessInterpretation}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                    <TextBlock Text="&gt;0 sağa çarpık (zor sınav), &lt;0 sola çarpık (kolay sınav), 0'a yakın simetrik çan eğrisi" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Basıklık Katsayısı -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="Basıklık Katsayısı (Kurtosis)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding ClassStats.Kurtosis, StringFormat='{}{0:F2}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}"/>
                                    <Border Background="{DynamicResource AccentBgLight}" CornerRadius="4" Padding="6,3" Margin="0,4,0,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ClassStats.KurtosisInterpretation}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}"/>
                                    </Border>
                                    <TextBlock Text="&gt;0 sivri (ortalamada yoğun yığılma), &lt;0 basık (düz/yayvan dağılım)" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- KR-20 & Cronbach Alfa -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="İç Tutarlık ve Güvenilirlik (KR-20 / Alfa)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <TextBlock Text="{Binding ReliabilityStats.KR20, StringFormat='{}KR-20: {0:F3}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" Margin="0,0,15,0"/>
                                        <TextBlock Text="{Binding ReliabilityStats.CronbachAlpha, StringFormat='{}Alfa: {0:F3}'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="0.70 üzeri kabul edilebilir, 0.80 üzeri yüksek güvenilirlik standardıdır." FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </Border>

                            <!-- Ölçmenin Standart Hatası (SeM) ve Güven Aralıkları -->
                            <Border Style="{StaticResource MetricRowCard}">
                                <StackPanel>
                                    <TextBlock Text="Ölçmenin Standart Hatası (SeM) &amp; Güven Aralığı" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding ClassStats.StandardErrorOfMeasurement, StringFormat='{}SeM: ±{0:F2} Puan'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentOrange}"/>
                                    <TextBlock Text="{Binding ClassStats.ConfidenceInterval68, StringFormat='{}%68 Güven Aralığı: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,3,0,1"/>
                                    <TextBlock Text="{Binding ClassStats.ConfidenceInterval95, StringFormat='{}%95 Güven Aralığı: {0}'}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Puan Frekans Tablosu ve Yüzdelikler -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource AcademicSectionCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="10'ar Puanlık Aralıklar Bazında Frekans" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding ScoreDistribution}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                              Background="Transparent" BorderThickness="0" IsReadOnly="True" GridLinesVisibility="None" RowHeight="30">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Puan Dilimi" Binding="{Binding Range}" Width="90"/>
                                            <DataGridTextColumn Header="Öğrenci" Binding="{Binding Count}" Width="65"/>
                                            <DataGridTextColumn Header="Oran (%)" Binding="{Binding Percentage, StringFormat='{}%{0:F1}'}" Width="75"/>
                                            <DataGridTemplateColumn Header="Dağılım" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="8" Foreground="{DynamicResource Accent}" Background="{DynamicResource HeaderBg}" BorderThickness="0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource AcademicSectionCard}" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Başarı Çeyrekleri ve Yüzdelikler (Percentile)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,10"/>
                                    
                                    <Border Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Üst %10 (En Başarılı Grup Sınırı)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding Percentiles[%90 (Üst Sınır)], StringFormat='{}{0:F1} Puan'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Üst %25 (Q3 - Üst Çeyrek)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding Percentiles[%75 (Q3 - Üst Çeyrek)], StringFormat='{}{0:F1} Puan'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentHover}"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Ortanca %50 (Medyan)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding Percentiles[%50 (Medyan - Ortanca)], StringFormat='{}{0:F1} Puan'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Alt %25 (Q1 - Alt Çeyrek)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding Percentiles[%25 (Q1 - Alt Çeyrek)], StringFormat='{}{0:F1} Puan'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Warning}"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="12,9">
                                        <Grid>
                                            <TextBlock Text="Alt %10 (Taban Puan Sınırı)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding Percentiles[%10 (Alt Sınır)], StringFormat='{}{0:F1} Puan'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Error}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: AKILLI PEDAGOJİK DEĞERLENDİRME VE METİN RAPORU -->
            <TabItem Header="🧠 Pedagojik Değerlendirme &amp; Metin">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,0,0">
                    <StackPanel>
                        <!-- Pedagojik Özet Kartı -->
                        <Border Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🧠 Otomatik Pedagojik &amp; Psikometrik Değerlendirme" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ClassStats.PedagogicalEvaluation}" FontSize="12" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <!-- Tam Metin Raporu -->
                        <Border Style="{StaticResource AcademicSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Resmi Arşiv / Dışa Aktarım Metin Raporu" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource HeaderBg}" CornerRadius="10" Padding="16">
                                    <TextBlock Text="{Binding ReportText}" 
                                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11.5" 
                                               Foreground="{DynamicResource TextMain}"
                                               TextWrapping="Wrap" LineHeight="19"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
